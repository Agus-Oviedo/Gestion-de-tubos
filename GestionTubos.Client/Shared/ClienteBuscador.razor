<div class="cliente-buscador position-relative" @onfocusout="CerrarAlPerderFoco">
@if(Seleccionado is not null&&!mostrarBusqueda){<div class="input-group"><div class="form-control bg-light"><strong>@Seleccionado.NombreMostrar</strong>@if(!string.IsNullOrWhiteSpace(Documento(Seleccionado))){<small class="text-muted ms-2">@Documento(Seleccionado)</small>}</div><button type="button" class="btn btn-outline-secondary" @onclick="Cambiar">Cambiar</button></div>}
else{<input class="form-control" type="search" value="@buscar" @oninput="Buscar" @onfocus="()=>mostrarBusqueda=true" placeholder="@Placeholder" autocomplete="off"/>@if(mostrarBusqueda){<div class="resultados list-group position-absolute w-100 shadow-sm">@if(Resultados.Count==0){<div class="list-group-item text-muted">No se encontraron clientes.</div>}@foreach(var c in Resultados){<button type="button" class="list-group-item list-group-item-action" @onclick="()=>Seleccionar(c)"><strong>@c.NombreMostrar</strong>@if(!string.IsNullOrWhiteSpace(Documento(c))){<small class="d-block text-muted">@Documento(c)</small>}</button>}</div>}}
</div>
@code{[Parameter]public IReadOnlyList<ClienteDto>Clientes{get;set;}=[];[Parameter]public int?ClienteId{get;set;}[Parameter]public EventCallback<int?>ClienteIdChanged{get;set;}[Parameter]public string Placeholder{get;set;}="Buscar por nombre, DNI o CUIT...";private string buscar="";private bool mostrarBusqueda;private ClienteDto?Seleccionado=>Clientes.FirstOrDefault(x=>x.Id==ClienteId);private List<ClienteDto>Resultados=>Clientes.Where(Coincide).Take(10).ToList();private bool Coincide(ClienteDto c)=>string.IsNullOrWhiteSpace(buscar)||c.NombreMostrar.Contains(buscar,StringComparison.OrdinalIgnoreCase)||(c.Dni?.Contains(buscar,StringComparison.OrdinalIgnoreCase)??false)||(c.CuitCuil?.Contains(buscar,StringComparison.OrdinalIgnoreCase)??false)||(c.NombreComercial?.Contains(buscar,StringComparison.OrdinalIgnoreCase)??false);private static string?Documento(ClienteDto c)=>!string.IsNullOrWhiteSpace(c.CuitCuil)?$"CUIT {c.CuitCuil}":!string.IsNullOrWhiteSpace(c.Dni)?$"DNI {c.Dni}":null;private void Buscar(ChangeEventArgs e){buscar=e.Value?.ToString()??"";mostrarBusqueda=true;}private async Task Seleccionar(ClienteDto c){buscar="";mostrarBusqueda=false;await ClienteIdChanged.InvokeAsync(c.Id);}private async Task Cambiar(){mostrarBusqueda=true;buscar="";await ClienteIdChanged.InvokeAsync(null);}private async Task CerrarAlPerderFoco(){await Task.Delay(150);mostrarBusqueda=false;await InvokeAsync(StateHasChanged);}}
<style>.cliente-buscador{z-index:20}.cliente-buscador .resultados{z-index:1050;max-height:19rem;overflow-y:auto;top:calc(100% + 2px);background:#fff}</style>
