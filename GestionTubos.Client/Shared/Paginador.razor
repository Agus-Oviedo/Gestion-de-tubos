@if(Conteo>Tamano){<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3"><small class="text-muted">@((PaginaActual-1)*Tamano+1)–@(Math.Min(PaginaActual*Tamano,Conteo)) de @Conteo</small><div class="d-flex align-items-center gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(PaginaActual<=1)" @onclick="()=>PaginaChanged.InvokeAsync(PaginaActual-1)">Anterior</button><span>Página @PaginaActual de @TotalPaginas</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(PaginaActual>=TotalPaginas)" @onclick="()=>PaginaChanged.InvokeAsync(PaginaActual+1)">Siguiente</button></div></div>}
@code{[Parameter]public int Conteo{get;set;}[Parameter]public int Tamano{get;set;}=25;[Parameter]public int Pagina{get;set;}=1;[Parameter]public EventCallback<int>PaginaChanged{get;set;}private int TotalPaginas=>Math.Max(1,(Conteo+Tamano-1)/Tamano);private int PaginaActual=>Math.Clamp(Pagina,1,TotalPaginas);}
