@page "/recepciones"
@page "/operaciones"
@attribute [Authorize]
@inject OperacionApiService Api
@inject NavigationManager Navigation
<PageTitle>Devoluciones pendientes</PageTitle>
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><h1>Devoluciones pendientes</h1><a class="btn btn-primary align-self-start" href="ingresos-clientes/nuevo">Recibir tubos de un cliente para carga</a></div>
<p class="text-muted">Remitos entregados que todavía tienen tubos en poder del cliente.</p>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Remito</th><th>Fecha</th><th>Cliente</th><th>Tubos pendientes</th><th></th></tr></thead><tbody>
@if(cargando){<tr><td colspan="5" class="text-center text-muted py-4">Cargando...</td></tr>}
else if(grupos.Count==0){<tr><td colspan="5" class="text-center text-muted py-5">No hay remitos pendientes de devolución.</td></tr>}
@foreach(var g in grupos){<tr><td><strong>@g.Numero</strong></td><td>@g.Fecha.EnArgentina().ToString("dd/MM/yyyy HH:mm")</td><td>@g.Cliente</td><td><span class="badge bg-warning text-dark">@g.Operaciones.Count</span></td><td class="text-end">@if(g.PedidoId.HasValue){<button class="btn btn-outline-primary btn-sm me-2" @onclick="()=>VerRemito(g.PedidoId.Value)">Ver remito</button>}<button class="btn btn-primary btn-sm" @onclick="()=>Abrir(g.RemitoId)">Registrar devolución</button></td></tr>}
</tbody></table></div></div>
@code{
 private bool cargando=true;private List<Grupo>grupos=[];
 protected override async Task OnInitializedAsync(){var tareaAbiertas=Api.Operaciones(true);var tareaRemitos=Api.Remitos(tipo:"Entrega");await Task.WhenAll(tareaAbiertas,tareaRemitos);var abiertas=await tareaAbiertas;var pedidos=(await tareaRemitos).Where(x=>x.PedidoId.HasValue).GroupBy(x=>x.Numero).ToDictionary(x=>x.Key,x=>x.First().PedidoId);grupos=abiertas.Where(x=>x.RemitoEntregaId.HasValue).GroupBy(x=>new{x.RemitoEntregaId,x.NumeroRemitoEntrega,x.Cliente}).Select(x=>{var numero=x.Key.NumeroRemitoEntrega??"Remito";pedidos.TryGetValue(numero,out var pedidoId);return new Grupo(x.Key.RemitoEntregaId!.Value,pedidoId,numero,x.Key.Cliente,x.Min(o=>o.FechaHoraUtc),x.OrderBy(o=>o.CodigoCilindro).ToList());}).OrderByDescending(x=>x.Fecha).ToList();cargando=false;}
 private void Abrir(long id)=>Navigation.NavigateTo($"devoluciones/remito/{id}");
 private void VerRemito(long pedidoId)=>Navigation.NavigateTo($"remitos/{pedidoId}?volver=recepciones");
 private sealed record Grupo(long RemitoId,long? PedidoId,string Numero,string Cliente,DateTime Fecha,List<OperacionDto>Operaciones);
}
