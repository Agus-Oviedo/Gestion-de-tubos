@page "/cilindros"
@attribute [Authorize]
@inject TuboApiService Api
@inject NavigationManager Nav
<PageTitle>Cilindros</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Cilindros</h1><p class="text-muted mb-0">Búsqueda y filtros instantáneos del inventario.</p></div><AuthorizeView Roles="Superadministrador,Administrador"><button class="btn btn-primary" @onclick="Nuevo">Nuevo cilindro</button></AuthorizeView></div>

<div class="card card-body shadow-sm mb-4"><div class="row g-3">
 <div class="col-lg-4"><label class="form-label">Búsqueda rápida</label><input type="search" class="form-control" placeholder="Código, serie, propietario, gas..." @bind="buscar" @bind:event="oninput"/></div>
 <div class="col-sm-6 col-lg-2"><label class="form-label">Gas</label><select class="form-select" @bind="gas"><option value="">Todos</option>@foreach(var x in Gases){<option value="@x">@x</option>}</select></div>
 <div class="col-sm-6 col-lg-2"><label class="form-label">Capacidad</label><select class="form-select" @bind="capacidad"><option value="">Todas</option>@foreach(var x in Capacidades){<option value="@x">@x</option>}</select></div>
 <div class="col-sm-6 col-lg-2"><label class="form-label">Estado operativo</label><select class="form-select" @bind="disponibilidad"><option value="0">Todos</option>@foreach(var x in EstadosDisponibilidad){<option value="@x">@NombreEstado(x)</option>}</select></div>
 <div class="col-sm-6 col-lg-2"><label class="form-label">Propietario</label><select class="form-select" @bind="tipoPropietario"><option value="0">Todos</option><option value="1">Oxígeno Norte</option><option value="2">Cliente</option><option value="3">Proveedor</option><option value="4">Otro tercero</option></select></div>
 <div class="col-sm-6 col-lg-3"><label class="form-label">Ubicación</label><select class="form-select" @bind="ubicacion"><option value="">Todas</option>@foreach(var x in Ubicaciones){<option value="@x">@x</option>}</select></div>
 <div class="col-sm-6 col-lg-3"><label class="form-label">Contenido</label><select class="form-select" @bind="contenido"><option value="0">Todos</option><option value="1">Lleno</option><option value="2">Vacío</option><option value="3">Parcial</option><option value="4">Desconocido</option></select></div>
 <div class="col-lg-6 d-flex align-items-end justify-content-lg-end"><span class="text-muted me-3 mb-2">@Filtrados.Count de @cilindros.Count cilindros</span><button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar filtros</button></div>
</div></div>

@if(error is not null){<div class="alert alert-danger">@error</div>}else if(cargando){<p>Cargando cilindros...</p>}else if(cilindros.Count==0){<div class="alert alert-info">Todavía no hay cilindros registrados. Primero cargá gases, capacidades y ubicaciones.</div>}else if(Filtrados.Count==0){<div class="alert alert-warning">No hay cilindros que coincidan con los filtros seleccionados.</div>}else{
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Código</th><th>Gas / capacidad</th><th>Propietario</th><th>Ubicación</th><th>Contenido</th><th>Estado operativo</th><th></th></tr></thead><tbody>@foreach(var x in Filtrados){<tr><td><strong>@x.CodigoInterno</strong><br/><small>@x.NumeroSerie</small></td><td>@x.Gas<br/><small>@x.Capacidad</small></td><td><span class="badge @(x.TipoPropietario==1?"bg-primary":"bg-info text-dark")">@TipoPropietario(x.TipoPropietario)</span><br/><small>@x.Propietario</small></td><td>@x.Ubicacion</td><td>@Contenido(x.EstadoContenido)</td><td><span class="badge @ClaseDisponibilidad(x.EstadoDisponibilidad)">@EstadoOperativo(x)</span></td><td class="text-end"><AuthorizeView Roles="Superadministrador,Administrador" Context="accionesRol"><button class="btn btn-sm btn-outline-primary me-2" @onclick="()=>Editar(x.Id)">Editar</button><ConfirmarAccion Texto="Baja" Mensaje="@($"¿Seguro que querés dar de baja el cilindro «{x.CodigoInterno}» (serie: {x.NumeroSerie})?")" OnConfirmar="()=>Baja(x.Id)" /></AuthorizeView></td></tr>}</tbody></table></div></div>}

@code{
 private List<TuboDto>cilindros=[];private string buscar="",gas="",capacidad="",ubicacion="";private int disponibilidad,tipoPropietario,contenido;private string?error;private bool cargando=true;
 private List<TuboDto>Filtrados=>cilindros.Where(Coincide).OrderBy(x=>x.CodigoInterno).ToList();private IEnumerable<string>Gases=>cilindros.Select(x=>x.Gas).Distinct().Order();private IEnumerable<string>Capacidades=>cilindros.Select(x=>x.Capacidad).Distinct().Order();private IEnumerable<string>Ubicaciones=>cilindros.Select(x=>x.Ubicacion).Distinct().Order();private IEnumerable<int>EstadosDisponibilidad=>cilindros.Select(x=>x.EstadoDisponibilidad).Distinct().Order();
 protected override async Task OnInitializedAsync(){try{cilindros=await Api.Todos();}catch(Exception e){error=e.Message;}finally{cargando=false;}}
 private bool Coincide(TuboDto x){var texto=string.Join(' ',x.CodigoInterno,x.NumeroSerie,x.IdentificacionGrabada,x.Propietario,x.Gas,x.Capacidad,x.Ubicacion,x.Marca,x.Fabricante);return(string.IsNullOrWhiteSpace(buscar)||texto.Contains(buscar,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrEmpty(gas)||x.Gas==gas)&&(string.IsNullOrEmpty(capacidad)||x.Capacidad==capacidad)&&(string.IsNullOrEmpty(ubicacion)||x.Ubicacion==ubicacion)&&(disponibilidad==0||x.EstadoDisponibilidad==disponibilidad)&&(tipoPropietario==0||x.TipoPropietario==tipoPropietario)&&(contenido==0||x.EstadoContenido==contenido);}
 private void LimpiarFiltros(){buscar=gas=capacidad=ubicacion="";disponibilidad=tipoPropietario=contenido=0;}private void Nuevo()=>Nav.NavigateTo("/cilindros/nuevo");private void Editar(int id)=>Nav.NavigateTo($"/cilindros/{id}");private async Task Baja(int id){try{await Api.Eliminar(id);cilindros=await Api.Todos();}catch(Exception e){error=e.Message;}}
 private static string TipoPropietario(int x)=>x switch{1=>"Oxígeno Norte",2=>"Cliente",3=>"Proveedor",4=>"Otro tercero",_=>"Desconocido"};private static string Contenido(int x)=>x switch{1=>"Lleno",2=>"Vacío",3=>"Parcial",_=>"Desconocido"};private static string NombreEstado(int x)=>x switch{1=>"Disponible / listo para devolver",2=>"Reservado",3=>"En reparto",4=>"En poder de su propietario",5=>"En carga",6=>"A inspeccionar",7=>"Mantenimiento",8=>"Prueba hidráulica",9=>"Baja",10=>"Extraviado",_=>"Desconocido"};private static string EstadoOperativo(TuboDto x)=>x.EstadoDisponibilidad switch{1 when x.TipoPropietario==2=>"Listo para devolver",1=>"Disponible",2 when x.TipoPropietario==2=>"Reservado para devolución",2=>"Reservado",3 when x.TipoPropietario==2=>"En reparto hacia su propietario",3=>"En reparto",4 when x.TipoPropietario==2=>"En poder de su propietario",4=>"Fuera de planta",5=>"En carga",6=>"A inspeccionar",7=>"Mantenimiento",8=>"Prueba hidráulica",9=>"Baja",10=>"Extraviado",_=>"Desconocido"};private static string ClaseDisponibilidad(int x)=>x switch{1=>"bg-success",2=>"bg-warning text-dark",3=>"bg-warning text-dark",4=>"bg-info text-dark",5=>"bg-primary",9 or 10=>"bg-danger",_=>"bg-secondary"};
}

