@page "/remitos/{PedidoId:long}"
@attribute [Authorize]
@inject PedidoApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ClienteApiService ClienteApi

<PageTitle>Remito @pedido?.NumeroRemito</PageTitle>
@if(cargando){<p>Cargando remito...</p>}
else if(pedido is null){<div class="alert alert-warning">No se encontró el remito solicitado.</div>}
else if(pedido.NumeroRemito is null){<div class="alert alert-warning">El pedido todavía no tiene un remito emitido.</div>}
else{
<div class="remito-actions mb-3"><button class="btn btn-outline-secondary me-2" @onclick="Volver">Volver</button>@if(pedido.FechaFirmaUtc.HasValue){<button class="btn btn-success" @onclick="DescargarYEnviar" disabled="@descargando">@(descargando?"Preparando...":"Descargar PDF y enviar por WhatsApp")</button>}<button class="btn btn-outline-primary ms-2" @onclick="Imprimir">Imprimir</button>@if(pedido.Estado is "Preparado" or "En reparto"){<button class="btn btn-success ms-2" @onclick="AbrirEntrega">Confirmar entrega</button>}</div>
<AuthorizeView Roles="Superadministrador,Administrador" Context="edicionRol"><div class="d-flex flex-wrap gap-2 mb-3 remito-no-print">@if(!pedido.FechaFirmaUtc.HasValue&&pedido.Estado!="Entregado"){<button class="btn btn-outline-primary" @onclick="()=>mostrarEdicion=!mostrarEdicion">Editar remito</button>}<button class="btn btn-outline-secondary" @onclick="()=>mostrarAuditoria=!mostrarAuditoria">Historial de cambios</button></div>
@if(mostrarEdicion&&!pedido.FechaFirmaUtc.HasValue&&pedido.Estado!="Entregado"){<RemitoEditor @key="pedido.Version" Pedido="pedido" OnGuardado="AlEditar" OnCancelar="()=>mostrarEdicion=false"/>}
@if(mostrarAuditoria){<section class="card card-body mb-3 remito-no-print"><h2 class="h4">Historial de cambios</h2><HistorialAuditoria PedidoId="pedido.Id" Version="pedido.Version"/></section>}</AuthorizeView>
@if(pedido.FechaFirmaUtc.HasValue){<p class="text-muted remito-no-print">Remito firmado: no se puede editar ni anular.</p>}
@if(pedido.FechaFirmaUtc.HasValue){<div class="alert alert-info remito-share-help"><strong>Al continuar:</strong> se descargará el PDF y se abrirá WhatsApp. Adjuntá allí el archivo descargado.</div>}
@if(!string.IsNullOrWhiteSpace(mensaje)){<div class="alert @(esError?"alert-danger":"alert-success")">@mensaje</div>}
@if(mostrarEntrega){<div class="card border-success shadow-sm mb-4"><div class="card-body"><h2 class="h4">Confirmar entrega de @pedido.NumeroRemito</h2><EditForm Model="entrega" OnValidSubmit="ConfirmarEntrega"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-5"><label class="form-label">Persona que recibe</label><InputText class="form-control" @bind-Value="entrega.PersonaRecibe"/></div><div class="col-md-3"><label class="form-label">DNI</label><InputText class="form-control" inputmode="numeric" @bind-Value="entrega.DniRecibe"/></div><div class="col-12"><label class="form-label">Descripción / observaciones</label><InputTextArea class="form-control" rows="3" maxlength="1000" placeholder="Ej.: pagó en efectivo, queda pendiente de pago u otra aclaración." @bind-Value="entrega.Observaciones"/><small class="text-muted">Se incluye en el remito y en el PDF. Hasta 1000 caracteres.</small></div><div class="col-12"><div class="d-flex justify-content-between align-items-center mb-2"><label class="form-label fw-bold mb-0">Firma de quien recibe</label><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFirma">Limpiar firma</button></div><canvas id="firma-remito-detalle" class="signature-canvas w-100" aria-label="Área para firmar con el dedo"></canvas></div></div><div class="mt-3"><button class="btn btn-success btn-lg me-2">Confirmar y finalizar entrega</button><button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CancelarEntrega">Cancelar</button></div></EditForm></div></div>}
<article class="remito-document">
 <header class="remito-header"><img src="oxigeno-norte-logo.png" alt="Oxígeno Norte"/><div><h1>REMITO</h1><strong>@pedido.NumeroRemito</strong><div>Fecha: @pedido.FechaHoraUtc.EnArgentina().ToString("dd/MM/yyyy HH:mm")</div></div></header>
 <section class="remito-company"><div><strong>OXÍGENO NORTE</strong><br/>Santa Rosa, La Pampa</div><div><strong>Pedido:</strong> @pedido.Numero<br/><strong>Tipo:</strong> Entrega<br/><strong>Estado:</strong> @pedido.Estado</div></section>
 <section class="remito-client"><span>DESTINATARIO</span><h2>@pedido.Cliente</h2><div>@DocumentoCliente()</div></section>
 <table class="remito-table"><colgroup><col style="width:60%"/><col style="width:20%"/><col style="width:20%"/></colgroup><thead><tr><th>Código del cilindro</th><th>Gas</th><th>Capacidad</th></tr></thead><tbody>@foreach(var c in pedido.Cilindros){<tr><td>@c.Codigo</td><td>@c.Gas</td><td>@c.Capacidad</td></tr>}</tbody><tfoot><tr><td colspan="2"><strong>Total de cilindros</strong></td><td><strong>@pedido.Cilindros.Count</strong></td></tr></tfoot></table>
 @if(!string.IsNullOrWhiteSpace(pedido.Observaciones)){<section class="remito-observations"><strong>Descripción / observaciones:</strong><p>@pedido.Observaciones</p></section>}
 @if(pedido.FechaFirmaUtc.HasValue){<section class="remito-electronic-signature"><div><img src="@pedido.FirmaDataUrl" alt="Firma electrónica de @pedido.PersonaRecibe"/></div><div><strong>@pedido.PersonaRecibe</strong><br/>DNI @pedido.DniRecibe<br/><small>Firmado el @pedido.FechaFirmaUtc.Value.EnArgentina().ToString("dd/MM/yyyy HH:mm")</small><br/><small>Entrega registrada por: @pedido.UsuarioEntrega</small></div></section>}else{<section class="remito-signatures"><div><span>Firma de quien recibe</span></div><div><span>Aclaración / DNI</span></div><div><span>Firma del responsable</span></div></section>}
 <footer>Documento interno generado por el Sistema de Gestión de Cilindros · @pedido.NumeroRemito</footer>
</article>}

@code{
 [Parameter]public long PedidoId{get;set;} [SupplyParameterFromQuery(Name="volver")]public string?VolverA{get;set;} private PedidoDto?pedido;private ClienteDto?cliente;private bool mostrarEdicion,mostrarAuditoria;private bool cargando=true;private bool descargando;private bool mostrarEntrega;private bool inicializarFirma;private bool esError;private string?mensaje;private PedidoEntregarDto entrega=new();
 protected override async Task OnParametersSetAsync(){cargando=true;pedido=(await Api.Obtener()).FirstOrDefault(x=>x.Id==PedidoId);cliente=pedido is null?null:await ClienteApi.ObtenerPorIdAsync(pedido.ClienteId);cargando=false;}
 private async Task AlEditar(){mostrarEdicion=false;pedido=(await Api.Obtener()).FirstOrDefault(x=>x.Id==PedidoId);cliente=pedido is null?null:await ClienteApi.ObtenerPorIdAsync(pedido.ClienteId);mensaje="Cambios guardados y registrados en auditoría.";esError=false;}
 private async Task GuardarPdf(){try{descargando=true;var bytes=await Api.DescargarPdf(PedidoId);await JS.InvokeVoidAsync("descargarArchivoBase64",NombreArchivo()+".pdf","application/pdf",Convert.ToBase64String(bytes));}catch(Exception ex){esError=true;mensaje=ex.Message;}finally{descargando=false;}}
 private Task Imprimir()=>JS.InvokeVoidAsync("print").AsTask();
 private string NombreArchivo()=> $"{NombreCliente()}_{pedido?.NumeroRemito??"remito"}";
 private async Task EnviarWhatsApp(){if(pedido is null)return;var destino=TelefonoWhatsApp.Destino(cliente?.Telefono??pedido.TelefonoEntrega);if(string.IsNullOrWhiteSpace(destino)){esError=true;mensaje="El cliente no tiene un teléfono cargado para WhatsApp.";return;}esError=false;mensaje=null;var nombre=NombreCliente();var fecha=(pedido.FechaFirmaUtc??pedido.FechaHoraUtc).EnArgentina().ToString("dd/MM/yyyy");var texto=$"Hola, {nombre}.\n\nOxígeno Norte le envía el comprobante de entrega {pedido.NumeroRemito}.\n\nCilindros entregados: {pedido.Cilindros.Count}\nFecha: {fecha}\n\nAdjuntamos el remito firmado para su registro.\nMuchas gracias.";await JS.InvokeVoidAsync("abrirWhatsApp",destino,texto);}
 private async Task DescargarYEnviar(){if(pedido is null)return;var destino=TelefonoWhatsApp.Destino(cliente?.Telefono??pedido.TelefonoEntrega);if(string.IsNullOrWhiteSpace(destino)){esError=true;mensaje="El cliente no tiene un teléfono cargado para WhatsApp.";return;}try{descargando=true;esError=false;mensaje=null;await JS.InvokeVoidAsync("prepararWhatsApp");var bytes=await Api.DescargarPdf(PedidoId);await JS.InvokeVoidAsync("descargarArchivoBase64",NombreArchivo()+".pdf","application/pdf",Convert.ToBase64String(bytes));var nombre=NombreCliente();var fecha=(pedido.FechaFirmaUtc??pedido.FechaHoraUtc).EnArgentina().ToString("dd/MM/yyyy");var texto=$"Hola, {nombre}.\n\nOxígeno Norte le envía el comprobante de entrega {pedido.NumeroRemito}.\n\nCilindros entregados: {pedido.Cilindros.Count}\nFecha: {fecha}\n\nAdjuntamos el remito firmado para su registro.\nMuchas gracias.";await JS.InvokeVoidAsync("abrirWhatsApp",destino,texto);}catch(Exception ex){esError=true;mensaje=ex.Message;}finally{descargando=false;}}
 private string NombreCliente(){if(cliente?.Tipo==1)return string.Join(" ",new[]{cliente.Nombre,cliente.Apellido}.Where(x=>!string.IsNullOrWhiteSpace(x)));return cliente?.RazonSocial??pedido?.Cliente??"cliente";}
 private string DocumentoCliente()=>cliente?.Tipo==2?$"CUIT: {cliente.CuitCuil??"Sin registrar"}":$"DNI: {cliente?.Dni??"Sin registrar"}";
 private void Volver()=>Navigation.NavigateTo(VolverA=="recepciones"?"recepciones":"pedidos");
 private void AbrirEntrega(){mostrarEntrega=true;mensaje=null;entrega=new(){Modalidad="Entrega",DiasSinCargo=0,VersionEsperada=pedido?.Version??0,Observaciones=pedido?.Observaciones};inicializarFirma=true;}
 private void CancelarEntrega(){mostrarEntrega=false;entrega=new();}
 private Task LimpiarFirma()=>JS.InvokeVoidAsync("firmaRemito.limpiar","firma-remito-detalle").AsTask();
 protected override async Task OnAfterRenderAsync(bool firstRender){if(inicializarFirma){inicializarFirma=false;await JS.InvokeVoidAsync("firmaRemito.inicializar","firma-remito-detalle");}}
 private async Task ConfirmarEntrega(){if(pedido is null)return;try{esError=false;mensaje=null;entrega.FirmaDataUrl=await JS.InvokeAsync<string>("firmaRemito.obtener","firma-remito-detalle");if(string.IsNullOrWhiteSpace(entrega.FirmaDataUrl)){esError=true;mensaje="La persona que recibe debe firmar el remito.";return;}await Api.ConfirmarEntrega(pedido.Id,entrega);pedido=(await Api.Obtener()).FirstOrDefault(x=>x.Id==PedidoId);mostrarEntrega=false;mensaje="Entrega confirmada. El remito pasó al historial y quedó pendiente de devolución.";}catch(Exception ex){esError=true;mensaje=ex.Message;}}
}
<style>.signature-canvas{display:block;height:260px;border:2px solid #198754;border-radius:.75rem;background:#fff;touch-action:none;cursor:crosshair}</style>
