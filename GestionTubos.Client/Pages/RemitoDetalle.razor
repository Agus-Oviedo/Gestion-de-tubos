@page "/remitos/{PedidoId:long}"
@attribute [Authorize]
@inject PedidoApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Remito @pedido?.NumeroRemito</PageTitle>
@if(cargando){<p>Cargando remito...</p>}
else if(pedido is null){<div class="alert alert-warning">No se encontró el remito solicitado.</div>}
else if(pedido.NumeroRemito is null){<div class="alert alert-warning">El pedido todavía no tiene un remito emitido.</div>}
else{
<div class="remito-actions mb-3"><button class="btn btn-outline-secondary me-2" @onclick="Volver">Volver</button><button class="btn btn-primary" @onclick="Imprimir">Imprimir remito</button>@if(pedido.Estado=="Preparado"){<button class="btn btn-success ms-2" @onclick="IrAEntrega">Confirmar entrega</button>}</div>
<article class="remito-document">
 <header class="remito-header"><img src="oxigeno-norte-logo.png" alt="Oxígeno Norte"/><div><h1>REMITO</h1><strong>@pedido.NumeroRemito</strong><div>Fecha: @pedido.FechaHoraUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div></header>
 <section class="remito-company"><div><strong>OXÍGENO NORTE</strong><br/>Santa Rosa, La Pampa<br/>Gestión y distribución de gases medicinales e industriales</div><div><strong>Pedido:</strong> @pedido.Numero<br/><strong>Estado:</strong> @pedido.Estado<br/><strong>Emitido por:</strong> @pedido.UsuarioCreador</div></section>
 <section class="remito-client"><span>DESTINATARIO</span><h2>@pedido.Cliente</h2><div>Cliente N.º @pedido.ClienteId</div></section>
 <table class="remito-table"><thead><tr><th>Cantidad</th><th>Código del cilindro</th><th>Gas</th><th>Capacidad</th></tr></thead><tbody>@foreach(var c in pedido.Cilindros){<tr><td>1</td><td>@c.Codigo</td><td>@c.Gas</td><td>@c.Capacidad</td></tr>}</tbody><tfoot><tr><td colspan="3"><strong>Total de cilindros</strong></td><td><strong>@pedido.Cilindros.Count</strong></td></tr></tfoot></table>
 @if(!string.IsNullOrWhiteSpace(pedido.Observaciones)){<section class="remito-observations"><strong>Observaciones:</strong><p>@pedido.Observaciones</p></section>}
 @if(pedido.FechaFirmaUtc.HasValue){<section class="remito-electronic-signature"><div><img src="@pedido.FirmaDataUrl" alt="Firma electrónica de @pedido.PersonaRecibe"/></div><div><strong>@pedido.PersonaRecibe</strong><br/>DNI @pedido.DniRecibe<br/><small>Firmado el @pedido.FechaFirmaUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><br/><small>Entrega registrada por @pedido.UsuarioEntrega</small></div></section><section class="remito-hash"><strong>Huella de integridad:</strong> @pedido.HuellaDocumento</section>}else{<section class="remito-signatures"><div><span>Firma de quien recibe</span></div><div><span>Aclaración / DNI</span></div><div><span>Firma del responsable</span></div></section>}
 <footer>Documento interno generado por el Sistema de Gestión de Cilindros · @pedido.NumeroRemito</footer>
</article>}

@code{
 [Parameter]public long PedidoId{get;set;} private PedidoDto?pedido;private bool cargando=true;
 protected override async Task OnParametersSetAsync(){cargando=true;pedido=(await Api.Obtener()).FirstOrDefault(x=>x.Id==PedidoId);cargando=false;}
 private Task Imprimir()=>JS.InvokeVoidAsync("print").AsTask();
 private void Volver()=>Navigation.NavigateTo("pedidos");
 private void IrAEntrega()=>Navigation.NavigateTo("pedidos");
}
