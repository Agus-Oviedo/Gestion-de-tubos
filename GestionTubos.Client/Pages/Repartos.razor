@page "/repartos"
@attribute [Authorize]
@inject RepartoApiService Api
@inject PedidoApiService PedidosApi
@inject CatalogoApiService Catalogos

<PageTitle>Repartos</PageTitle>
<h1>Repartos</h1>
<p class="text-muted">Prepará las salidas, confirmá entregas y registrá los retornos a planta.</p>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(error ? "alert-danger" : "alert-success")">@mensaje</div>
}

<div class="card card-body shadow-sm mb-4">
    <h2 class="h4">Nueva hoja de reparto</h2>
    <EditForm Model="nuevo" OnValidSubmit="Crear">
        <DataAnnotationsValidator /><ValidationSummary />
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Fecha</label><InputDate class="form-control" @bind-Value="nuevo.Fecha" /></div>
            <div class="col-md-4"><label class="form-label">Responsable</label><InputText class="form-control" @bind-Value="nuevo.Responsable" /></div>
            <div class="col-md-5"><label class="form-label">Observaciones</label><InputText class="form-control" @bind-Value="nuevo.Observaciones" /></div>
        </div>
        <label class="form-label mt-3">Pedidos a domicilio preparados</label>
        <div class="cylinder-picker">
            @if (preparados.Count == 0) { <span class="text-muted">No hay entregas a domicilio preparadas sin asignar.</span> }
            @foreach (var p in preparados)
            {
                <label class="form-check"><input class="form-check-input" type="checkbox" checked="@nuevo.PedidoIds.Contains(p.Id)" @onchange="e => Seleccionar(p.Id, (bool)(e.Value ?? false))" /><span class="form-check-label"><strong>@p.Numero</strong> · @p.NumeroRemito · @p.Cliente · @p.DireccionEntregaTexto · @p.Cilindros.Count cilindro(s)</span></label>
            }
        </div>
        <button class="btn btn-primary mt-3">Crear reparto</button>
    </EditForm>
</div>

@foreach (var reparto in repartos)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><strong>@reparto.Numero</strong> · @reparto.Fecha.ToString("dd/MM/yyyy") · @reparto.Responsable</div>
            <span class="badge @ClaseEstado(reparto.Estado)">@reparto.Estado</span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(reparto.Observaciones))
            {
                <div class="alert alert-light border" style="white-space:pre-line">@reparto.Observaciones</div>
            }

            @foreach (var pedido in reparto.Pedidos)
            {
                <div class="border rounded p-3 mb-2">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div><strong>@pedido.NumeroPedido</strong> · @pedido.NumeroRemito<br /><span>@pedido.Cliente · @pedido.CantidadCilindros cilindro(s)</span></div>
                        <div class="d-flex align-items-center gap-2"><span class="badge bg-secondary">@pedido.Estado</span>
                            @if (pedido.Estado == "En reparto")
                            {
                                <a class="btn btn-sm btn-success" href="pedidos">Confirmar entrega</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => PrepararNoEntregado(reparto.Id, pedido.PedidoId)">No entregado</button>
                            }
                        </div>
                    </div>

                    @if (noEntregado?.RepartoId == reparto.Id && noEntregado.PedidoId == pedido.PedidoId)
                    {
                        <EditForm Model="noEntregado.Dto" OnValidSubmit="ConfirmarNoEntregado" class="border rounded bg-light p-3 mt-3">
                            <DataAnnotationsValidator /><ValidationSummary />
                            <h3 class="h6">Retorno a planta de @pedido.NumeroPedido</h3>
                            <div class="row g-2">
                                <div class="col-md-5"><label class="form-label">Motivo</label><InputText class="form-control" @bind-Value="noEntregado.Dto.Motivo" /></div>
                                <div class="col-md-3"><label class="form-label">Ubicación de retorno</label><InputSelect class="form-select" @bind-Value="noEntregado.Dto.UbicacionRetornoId"><option value="0">Seleccionar</option>@foreach (var u in ubicaciones) { <option value="@u.Id">@u.Nombre</option> }</InputSelect></div>
                                <div class="col-md-4"><label class="form-label">Qué hacer con el pedido</label><InputSelect class="form-select" @bind-Value="noEntregado.Dto.Accion"><option value="Reprogramar">Reprogramar otro reparto</option><option value="CancelarPedido">Cancelar pedido y liberar cilindros</option></InputSelect></div>
                            </div>
                            <div class="mt-2"><button class="btn btn-danger btn-sm me-2">Confirmar retorno</button><button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => noEntregado = null">Volver</button></div>
                        </EditForm>
                    }
                </div>
            }

            @if (reparto.Estado == "Preparado")
            {
                <div class="d-flex gap-2 mt-3"><button class="btn btn-warning" @onclick="() => Iniciar(reparto.Id)">Iniciar reparto</button><button class="btn btn-outline-danger" @onclick="() => PrepararAnulacion(reparto.Id)">Anular antes de salir</button></div>
                @if (anulacion?.RepartoId == reparto.Id)
                {
                    <EditForm Model="anulacion.Dto" OnValidSubmit="ConfirmarAnulacion" class="border rounded bg-light p-3 mt-3">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <label class="form-label">Motivo de anulación</label><InputText class="form-control mb-2" @bind-Value="anulacion.Dto.Motivo" />
                        <button class="btn btn-danger btn-sm me-2">Confirmar anulación</button><button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => anulacion = null">Volver</button>
                    </EditForm>
                }
            }
        </div>
    </div>
}

@code {
    private RepartoCrearDto nuevo = new();
    private List<PedidoDto> preparados = [];
    private List<RepartoDto> repartos = [];
    private List<UbicacionDto> ubicaciones = [];
    private AnulacionVm? anulacion;
    private NoEntregadoVm? noEntregado;
    private string? mensaje;
    private bool error;

    protected override async Task OnInitializedAsync() { ubicaciones = await Catalogos.UbicacionesAsync(); await Cargar(); }
    private async Task Cargar() { repartos = await Api.Obtener(); var asignados = repartos.SelectMany(x => x.Pedidos).Select(x => x.PedidoId).ToHashSet(); preparados = (await PedidosApi.Obtener()).Where(x => x.Estado == "Preparado" && x.ModalidadEntrega == "Domicilio" && !asignados.Contains(x.Id)).ToList(); }
    private void Seleccionar(long id, bool elegido) { if (elegido && !nuevo.PedidoIds.Contains(id)) nuevo.PedidoIds.Add(id); else if (!elegido) nuevo.PedidoIds.Remove(id); }
    private void PrepararAnulacion(long id) { anulacion = new(id, new()); noEntregado = null; }
    private void PrepararNoEntregado(long repartoId, long pedidoId) { noEntregado = new(repartoId, pedidoId, new()); anulacion = null; }
    private Task Crear() => Ejecutar(async () => { await Api.Crear(nuevo); nuevo = new(); mensaje = "Reparto creado correctamente."; });
    private Task Iniciar(long id) => Ejecutar(async () => { await Api.Iniciar(id); mensaje = "Reparto iniciado. Los cilindros están en reparto."; });
    private Task ConfirmarAnulacion() => anulacion is null ? Task.CompletedTask : Ejecutar(async () => { await Api.Anular(anulacion.RepartoId, anulacion.Dto); anulacion = null; mensaje = "Reparto anulado. Los pedidos quedaron preparados para otra asignación."; });
    private Task ConfirmarNoEntregado() => noEntregado is null ? Task.CompletedTask : Ejecutar(async () => { var reprogramar = noEntregado.Dto.Accion == "Reprogramar"; await Api.NoEntregado(noEntregado.RepartoId, noEntregado.PedidoId, noEntregado.Dto); noEntregado = null; mensaje = reprogramar ? "Retorno registrado. El pedido quedó preparado para reprogramar." : "Retorno registrado. Pedido cancelado y cilindros disponibles."; });
    private async Task Ejecutar(Func<Task> accion) { try { error = false; mensaje = null; await accion(); await Cargar(); } catch (Exception ex) { error = true; mensaje = ex.Message; } }
    private static string ClaseEstado(string estado) => estado switch { "Completado" => "bg-success", "Completado con novedades" => "bg-warning text-dark", "En reparto" => "bg-primary", "Anulado" => "bg-danger", _ => "bg-info text-dark" };
    private sealed record AnulacionVm(long RepartoId, RepartoAnularDto Dto);
    private sealed record NoEntregadoVm(long RepartoId, long PedidoId, RepartoNoEntregadoDto Dto);
}
