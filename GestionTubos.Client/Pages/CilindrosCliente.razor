@page "/clientes/{ClienteId:int}/cilindros"
@attribute [Authorize]
@inject ClienteApiService ClientesApi
@inject TuboApiService CilindrosApi
@inject NavigationManager Navigation
<PageTitle>Cilindros del cliente</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Cilindros de @cliente?.NombreMostrar</h1><p class="text-muted mb-0">Cilindros que pertenecen exclusivamente a este cliente.</p></div><div class="d-flex gap-2"><AuthorizeView Roles="Superadministrador,Administrador"><a class="btn btn-primary" href="@($"cilindros/nuevo?clienteId={ClienteId}")">Registrar cilindro del cliente</a></AuthorizeView><button class="btn btn-outline-secondary" @onclick="Volver">Volver</button></div></div>
@if(cargando){<p>Cargando...</p>}else if(error is not null){<div class="alert alert-danger">@error</div>}else if(cilindros.Count==0){<div class="alert alert-info"><strong>Este cliente todavía no tiene cilindros propios.</strong><br/>Usá “Registrar cilindro del cliente” para cargar el primero; el propietario quedará seleccionado automáticamente.</div>}else{
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><span class="text-muted">Total propios</span><strong class="fs-3">@cilindros.Count</strong></div></div><div class="col-md-4"><div class="card card-body"><span class="text-muted">Listos para devolver</span><strong class="fs-3 text-success">@cilindros.Count(x=>x.EstadoDisponibilidad==1)</strong></div></div><div class="col-md-4"><div class="card card-body"><span class="text-muted">En proceso o fuera de planta</span><strong class="fs-3">@cilindros.Count(x=>x.EstadoDisponibilidad!=1)</strong></div></div></div>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Código</th><th>Gas</th><th>Capacidad</th><th>Ubicación</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var c in cilindros){<tr><td><strong>@c.CodigoInterno</strong><br/><small>@c.NumeroSerie</small></td><td>@c.Gas</td><td>@c.Capacidad</td><td>@c.Ubicacion</td><td><span class="badge @(c.EstadoDisponibilidad==1?"bg-success":"bg-secondary")">@Estado(c.EstadoDisponibilidad)</span></td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-primary" href="@($"recepciones?clienteId={ClienteId}&cilindroId={c.Id}")">Recibir para carga</a><a class="btn btn-sm btn-outline-secondary" href="@($"movimientos?cilindroId={c.Id}")">Historial</a><AuthorizeView Roles="Superadministrador,Administrador"><a class="btn btn-sm btn-outline-primary" href="@($"cilindros/{c.Id}?clienteId={ClienteId}")">Editar</a><a class="btn btn-sm btn-outline-warning" href="@($"pruebas-hidraulicas?cilindroId={c.Id}")">Prueba hidráulica</a></AuthorizeView></div></td></tr>}</tbody></table></div>}
@code{[Parameter]public int ClienteId{get;set;}private ClienteDto?cliente;private List<TuboDto>cilindros=[];private bool cargando=true;private string?error;protected override async Task OnParametersSetAsync(){try{cargando=true;cliente=await ClientesApi.ObtenerPorIdAsync(ClienteId);cilindros=await CilindrosApi.PorCliente(ClienteId);}catch(Exception e){error=e.Message;}finally{cargando=false;}}private void Volver()=>Navigation.NavigateTo("clientes");private static string Estado(int e)=>e switch{1=>"Listo para devolver al cliente",2=>"Reservado para devolución",3=>"En reparto hacia el cliente",4=>"En poder de su propietario",5=>"En carga",6=>"Pendiente de inspección",7=>"En mantenimiento",8=>"En prueba hidráulica",9=>"Dado de baja",10=>"Extraviado",_=>"Desconocido"};}
