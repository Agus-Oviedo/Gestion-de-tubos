@page "/pruebas-hidraulicas"
@attribute [Authorize]
@inject GestionTubos.Client.Services.OperacionApiService Api
@inject GestionTubos.Client.Services.TuboApiService CilindrosApi
<PageTitle>Pruebas hidráulicas</PageTitle><h1>Pruebas hidráulicas</h1><p class="text-muted">Vencimientos calculados a partir del último certificado registrado.</p>
@if(error is not null){<div class="alert alert-danger">@error</div>}
<EditForm Model="modelo" OnValidSubmit="Guardar" class="card card-body mb-4"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3">
<div class="col-md-4"><label class="form-label">Cilindro</label><InputSelect class="form-select" @bind-Value="modelo.CilindroId"><option value="0">Seleccionar</option>@foreach(var x in cilindros){<option value="@x.Id">@x.CodigoInterno</option>}</InputSelect></div>
<div class="col-md-4"><label class="form-label">Realización</label><InputDate class="form-control" @bind-Value="modelo.FechaRealizacion"/></div><div class="col-md-4"><label class="form-label">Vencimiento</label><InputDate class="form-control" @bind-Value="modelo.FechaVencimiento"/></div>
<div class="col-md-5"><label class="form-label">Entidad realizadora</label><InputText class="form-control" @bind-Value="modelo.EntidadRealizadora"/></div><div class="col-md-4"><label class="form-label">Certificado</label><InputText class="form-control" @bind-Value="modelo.NumeroCertificado"/></div><div class="col-md-3 d-flex align-items-end"><label class="mb-2"><InputCheckbox class="form-check-input me-2" @bind-Value="modelo.Aprobada"/>Aprobada</label></div>
<div class="col-12"><label class="form-label">Observaciones</label><InputTextArea class="form-control" @bind-Value="modelo.Observaciones"/></div></div><button class="btn btn-primary mt-3 align-self-start">Registrar prueba</button></EditForm>
<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Cilindro</th><th>Realización</th><th>Vencimiento</th><th>Estado</th><th>Entidad / certificado</th></tr></thead><tbody>@if(!PruebasVisibles.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Este cilindro no tiene pruebas registradas.</td></tr>}@foreach(var x in PruebasVisibles){<tr><td><strong>@x.CodigoCilindro</strong></td><td>@x.FechaRealizacion.ToString("dd/MM/yyyy")</td><td>@x.FechaVencimiento.ToString("dd/MM/yyyy")</td><td><span class="badge @(x.Estado=="Vigente"?"bg-success":x.Estado.StartsWith("Próxima")?"bg-warning text-dark":"bg-danger")">@x.Estado</span></td><td>@x.EntidadRealizadora<br/><small>@x.NumeroCertificado</small></td></tr>}</tbody></table></div></div>
@code{[SupplyParameterFromQuery(Name="cilindroId")]public int?CilindroId{get;set;}private PruebaHidraulicaGuardarDto modelo=new();private List<TuboDto>cilindros=[];private List<PruebaHidraulicaDto>pruebas=[];private IEnumerable<PruebaHidraulicaDto>PruebasVisibles=>CilindroId.HasValue?pruebas.Where(x=>x.CilindroId==CilindroId):pruebas;private string?error;protected override async Task OnInitializedAsync(){cilindros=await CilindrosApi.Todos();if(CilindroId.HasValue&&cilindros.Any(x=>x.Id==CilindroId))modelo.CilindroId=CilindroId.Value;await Cargar();}private async Task Cargar()=>pruebas=await Api.Pruebas();private async Task Guardar(){try{error=null;await Api.RegistrarPrueba(modelo);modelo=new(){CilindroId=CilindroId??0};await Cargar();}catch(Exception e){error=e.Message;}}}
