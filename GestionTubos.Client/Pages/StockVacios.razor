@page "/stock-vacios"
@page "/cargas/preparar"
@page "/cargas/preparar/{EnvioId:long}"
@page "/cargas/pendientes"
@page "/cargas/pendientes/{EnvioId:long}"
@page "/cargas/envios"
@page "/cargas/envios/{EnvioId:long}"
@page "/cargas/historial"
@attribute [Authorize]
@inject CargaLoteApiService Api
@inject CatalogoApiService Catalogos
@inject IJSRuntime JS
@inject NavigationManager Navigation
<PageTitle>@Titulo</PageTitle>
<div inert="@(mostrarVista||remitoViendo is not null||editandoPendiente is not null)">
<h1>@Titulo</h1>
<p>@(Preparando?"Seleccioná los vacíos aptos y revisá el remito antes de confirmar el envío.":Seccion=="stock"?"Consultá los tubos propios y de clientes recibidos en planta, incluidos los reservados o no aptos.":Seccion=="pendientes"?"Revisá los remitos guardados, corregí los tubos y confirmá la salida cuando estén verificados.":Seccion=="envios"?"Abrí un envío pendiente para registrar los tubos que regresaron.":"Consultá los remitos de envío y recepción de carga.")</p>
@if(error is not null){<div class="alert alert-danger" role="alert">@error</div>}
@if(ocupado){<p>Procesando...</p>}
<div class="d-flex justify-content-end mb-3"><button class="btn btn-outline-secondary" disabled="@ocupado" @onclick="Actualizar">Actualizar</button></div>
@if(Seccion=="stock"&&detalle is null){
 <section class="card card-body mb-4"><h2 class="h4">Vacíos en planta</h2><p class="text-muted">@(Preparando?"Se pueden enviar tubos propios y de clientes con ingreso registrado, disponibles y aptos. La salida se registra al confirmar el remito.":"Los tubos reservados siguen en planta hasta confirmar su salida. Para enviarlos, entrá en Preparar envío.")</p>
 <div class="row g-3 mb-3"><div class="col-md-8"><label for="buscarVacio" class="form-label">Buscar tubo vacío</label><input id="buscarVacio" type="search" class="form-control" placeholder="Código, gas, propietario, capacidad o ubicación" @bind="BuscarVacio" @bind:event="oninput"/></div><div class="col-md-4"><label for="condicionVacio" class="form-label">Condición</label><select id="condicionVacio" class="form-select" @bind="CondicionVacio"><option value="Todos">Todos</option><option value="Aptos">Aptos para enviar</option><option value="No aptos">Reservados / no aptos</option></select></div></div>
 @if(Preparando){
 <div class="d-flex flex-wrap align-items-center gap-2 mb-3"><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="SeleccionarTodos">Seleccionar / desmarcar los aptos encontrados (@VaciosFiltrados.Count(x=>x.Apto))</button><button type="button" class="btn btn-outline-secondary" @onclick="()=>seleccion.Clear()">Limpiar selección</button><span>@seleccion.Count seleccionados en total · @VaciosFiltrados.Count encontrados</span></div>
 }
 <div class="table-responsive"><table class="table"><thead><tr>@if(Preparando){<th></th>}<th>Tubo</th><th>Gas / capacidad / propietario</th><th>Ubicación</th><th>Condición</th></tr></thead><tbody>@foreach(var t in VaciosPagina){<tr>@if(Preparando){<td><input type="checkbox" aria-label="Seleccionar @t.Codigo" disabled="@(!t.Apto||ocupado)" checked="@seleccion.Contains(t.Id)" @onchange="e=>Marcar(t.Id,(bool)(e.Value??false))"/></td>}<td>@t.Codigo</td><td>@t.Gas · @t.Capacidad<br/><small class="text-muted">@t.Propietario</small></td><td>@t.Ubicacion</td><td>@t.Motivo</td></tr>}@if(VaciosFiltrados.Count==0){<tr><td colspan="5">No hay tubos vacíos que coincidan con la búsqueda.</td></tr>}</tbody></table></div>
 <Paginador Conteo="@VaciosFiltrados.Count" @bind-Pagina="paginaVacios"/>@if(Preparando){<hr/><h3 class="h5">Preparar envío con los tubos seleccionados</h3>
 <EditForm Model="nuevo" OnSubmit="PrepararEnvio"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-6"><label class="form-label">Destino / cargadora</label><InputText class="form-control" @bind-Value="nuevo.Destino"/></div><div class="col-md-6"><label class="form-label">Transporte</label><InputText class="form-control" @bind-Value="nuevo.Transporte"/></div><div class="col-12"><label class="form-label">Observaciones</label><InputTextArea class="form-control" @bind-Value="nuevo.Observaciones"/></div></div><button class="btn btn-primary mt-3" disabled="@(ocupado||seleccion.Count==0)">Preparar remito de envío (@seleccion.Count tubos)</button></EditForm>}else{<a class="btn btn-primary align-self-start mt-3" href="cargas/preparar">Preparar envío de vacíos</a>}</section>
}else if(detalle is not null){
 var envio=detalle;
 <article class="card card-body mb-4">@if(Preparando){<a href="cargas/preparar" class="mb-3">← Volver a preparar envíos</a>}<h2 class="h4">Remito de envío @envio.Numero</h2><p><strong>@EstadoCarga(envio.Estado)</strong> · @envio.Destino · Transporte: @envio.Transporte</p><p>Preparado: @envio.FechaCreacionUtc.EnArgentina().ToString("dd/MM/yyyy HH:mm") @if(envio.FechaSalidaUtc.HasValue){<span>· Salida: @envio.FechaSalidaUtc.Value.EnArgentina().ToString("dd/MM/yyyy HH:mm") · @DiasFuera(envio) días desde la salida</span>}</p><p>@envio.Observaciones</p>
 <div class="d-flex flex-wrap gap-2 mb-3"><button class="btn btn-outline-primary" disabled="@ocupado" @onclick="()=>Pdf(envio.Id,null,envio.Numero)">Descargar remito de envío</button>@if(envio.Estado=="Preparado"){<button class="btn btn-outline-primary" @onclick="()=>EditarPendiente(envio)">Corregir tubos / datos</button><ConfirmarAccion Texto="Confirmar salida" Mensaje="¿Confirmás que estos tubos salen de planta hacia la cargadora?" OnConfirmar="()=>Ejecutar(()=>Api.Salida(envio.Id))"/><ConfirmarAccion Texto="Cancelar preparación" Mensaje="¿Cancelar el remito y liberar los tubos reservados?" OnConfirmar="()=>Ejecutar(()=>Api.Cancelar(envio.Id))"/>}</div>
 @if(panelDetalle=="detalle"){
 <div class="table-responsive"><table class="table"><thead><tr><th>Tubo</th><th>Gas / capacidad / propietario</th><th>Estado en este envío</th></tr></thead><tbody>@foreach(var t in DetallesPagina){<tr><td>@t.Codigo</td><td>@t.Gas · @t.Capacidad<br/><small class="text-muted">@t.Propietario</small></td><td>@t.Estado @t.Resolucion</td></tr>}</tbody></table></div>
 <Paginador Conteo="@envio.Tubos.Count" @bind-Pagina="paginaDetalle"/>
 <p><strong>@envio.Tubos.Count enviados/preparados</strong> · @envio.Tubos.Count(x=>x.Estado=="Recibido") recibidos · @envio.Tubos.Count(x=>x.Estado=="Pendiente") pendientes · @envio.Tubos.Count(x=>x.Estado=="Faltante resuelto") faltantes resueltos</p>
 }
 @if(panelDetalle=="recepcion" && envio.Estado is ("Enviado" or "Parcial")){
 <h3 class="h5">Registrar recepción parcial o total</h3><label for="buscarRetorno" class="form-label">Buscar tubo enviado pendiente</label><input id="buscarRetorno" type="search" class="form-control mb-3" @bind="BuscarRetorno" @bind:event="oninput" placeholder="Código o gas"/><p>Marcá únicamente los tubos que volvieron y su condición real.</p><button class="btn btn-outline-secondary align-self-start mb-2" @onclick="()=>MarcarRetornos(envio)">Seleccionar los pendientes encontrados (@RetornosFiltrados.Count)</button>
 @foreach(var t in RetornosPagina){<div class="row g-2 mb-2"><div class="col-md-6"><label><input type="checkbox" checked="@retornos.ContainsKey(t.Id)" @onchange="e=>MarcarRetorno(t.Id,(bool)(e.Value??false))"/> @t.Codigo · @t.Gas · @t.Capacidad · @t.Propietario</label></div><div class="col-md-6">@if(retornos.ContainsKey(t.Id)){<select class="form-select" aria-label="Condición de @t.Codigo" value="@retornos[t.Id]" @onchange="e=>CambiarResultado(t.Id,e)"><option value="Lleno">Lleno</option><option value="Vacio">Vacío / rechazado</option><option value="Danado">Dañado (pasa a mantenimiento)</option></select>}</div></div>}
 <Paginador Conteo="@RetornosFiltrados.Count" @bind-Pagina="paginaRetornos"/><hr/>
 <EditForm Model="recepcion" OnSubmit="PrepararRecepcion"><DataAnnotationsValidator/><ValidationSummary/><label class="form-label">Ubicación de recepción en planta</label><InputSelect class="form-select mb-2" @bind-Value="recepcion.UbicacionDestinoId"><option value="0">Seleccionar</option>@foreach(var u in ubicaciones){<option value="@u.Id">@u.Nombre</option>}</InputSelect><label class="form-label">Observaciones de recepción</label><InputTextArea class="form-control mb-2" @bind-Value="recepcion.Observaciones"/><button class="btn btn-success" disabled="@(ocupado||retornos.Count==0)">Confirmar recepción y generar remito (@retornos.Count)</button></EditForm>
 <details class="mt-4"><summary>Resolver un faltante definitivo</summary><p class="text-muted">No usar para tubos que todavía van a regresar. Marca el tubo como extraviado y conserva el motivo.</p><select class="form-select mb-2" @bind="faltante.DetalleId"><option value="0">Seleccionar tubo pendiente</option>@foreach(var t in envio.Tubos.Where(x=>x.Estado=="Pendiente")){<option value="@t.Id">@t.Codigo</option>}</select><input class="form-control mb-2" placeholder="Motivo del faltante definitivo" maxlength="1000" @bind="faltante.Motivo"/><ConfirmarAccion Texto="Registrar faltante definitivo" Mensaje="¿Confirmás que este tubo no regresará y debe registrarse como extraviado?" OnConfirmar="Resolver"/></details>
 }
 </article>
}
@if((Preparando||Seccion=="envios") && detalle is null){
<section class="card card-body"><h2 class="h4">@(Preparando?"Envíos pendientes de verificación y salida":"Envíos pendientes de regreso")</h2><label for="buscarEnvio" class="form-label">Buscar envío</label><input id="buscarEnvio" type="search" class="form-control mb-3" placeholder="Remito, destino o transporte" @bind="BuscarEnvio" @bind:event="oninput"/><div class="table-responsive"><table class="table"><thead><tr><th>Remito / fecha</th><th>Destino / transporte</th><th>Estado</th><th>@(Preparando?"Tubos a verificar":"Tubos por regresar")</th><th></th></tr></thead><tbody>@foreach(var e in EnviosPagina){<tr><td>@e.Numero<br/><small>@e.FechaCreacionUtc.EnArgentina().ToString("dd/MM/yyyy")</small></td><td>@e.Destino<br/><small>@e.Transporte</small></td><td>@EstadoCarga(e.Estado)</td><td>@e.Tubos.Count(x=>x.Estado=="Pendiente")</td><td><button class="btn btn-sm btn-outline-primary" disabled="@ocupado" @onclick="()=>Abrir(e)">@(e.Estado=="Preparado"?"Revisar y confirmar":"Registrar recepción")</button></td></tr>}@if(EnviosFiltrados.Count==0){<tr><td colspan="5" class="text-muted">No hay envíos pendientes para esta búsqueda.</td></tr>}</tbody></table></div><Paginador Conteo="@EnviosFiltrados.Count" @bind-Pagina="paginaEnvios"/></section>
}
@if(Seccion=="historial"){
<section class="card card-body"><h2 class="h4">Historial de cargas</h2><div class="row g-3 mb-3"><div class="col-md-8"><label for="buscarRemitoCarga" class="form-label">Buscar remito o tubo</label><input id="buscarRemitoCarga" type="search" class="form-control" placeholder="Número, código de tubo, destino o transporte" @bind="BuscarHistorial" @bind:event="oninput"/></div><div class="col-md-4"><label for="tipoRemitoCarga" class="form-label">Tipo</label><select id="tipoRemitoCarga" class="form-select" @bind="TipoHistorial"><option value="Todos">Todos</option><option value="Envío">Envíos</option><option value="Recepción">Recepciones</option></select></div></div>
@if(FiltroEnvioId.HasValue){<p>Remitos del envío seleccionado. <a href="cargas/historial">Ver todo el historial</a></p>}
<div class="table-responsive"><table class="table"><thead><tr><th>Remito</th><th>Tipo / fecha</th><th>Destino</th><th>Envío original</th><th>Tubos</th><th></th></tr></thead><tbody>@foreach(var r in HistorialPagina){<tr><td><strong>@r.Numero</strong><br/><small>@EstadoCarga(r.Estado)</small></td><td>@r.Tipo<br/><small>@r.Fecha.EnArgentina().ToString("dd/MM/yyyy HH:mm")</small></td><td>@r.Destino</td><td><a href="@($"cargas/envios/{r.EnvioId}")">@r.EnvioNumero</a></td><td>@r.Cantidad</td><td><button class="btn btn-sm btn-primary me-2" @onclick="()=>VerRemito(r)">Ver remito</button><button class="btn btn-sm btn-outline-primary" @onclick="()=>Pdf(r.EnvioId,r.RecepcionId,r.Numero)">Descargar PDF</button></td></tr>}@if(HistorialFiltrado.Count==0){<tr><td colspan="6">No hay remitos para esta búsqueda.</td></tr>}</tbody></table></div><Paginador Conteo="@HistorialFiltrado.Count" @bind-Pagina="paginaHistorial"/></section>
}
</div>
@if(mostrarVista){
 <div class="modal-backdrop show"></div>
 <div class="modal d-block" role="dialog" aria-modal="true" aria-labelledby="tituloVistaCarga" tabindex="-1">
 <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
 <div class="modal-header"><h2 id="tituloVistaCarga" class="modal-title h5">@(confirmadoVista is null?"Revisar y confirmar envío":confirmadoVista.Estado=="Preparado"?"Remito pendiente de verificación":"Envío confirmado")</h2><button class="btn-close" aria-label="Cerrar vista previa" disabled="@ocupado" @onclick="CerrarVista"></button></div>
 <div class="modal-body">
 @if(errorVista is not null){<div class="alert alert-danger">@errorVista</div>}
 @if(confirmadoVista is not null){<div class="alert alert-success">@(confirmadoVista.Estado=="Preparado"?"Remito guardado pendiente. Los tubos quedan reservados en planta. Podés retomarlo desde la lista debajo de Preparar envío para corregirlo o confirmar la salida.":"El envío quedó confirmado y guardado en el historial. Los tubos ya figuran enviados a carga.")</div>}
 <article class="remito-document"><header class="remito-header"><img src="oxigeno-norte-logo.png" alt="Oxígeno Norte"/><div><h3>ENVÍO A CARGA</h3><strong>@(confirmadoVista?.Numero??"Vista previa")</strong><div>@(confirmadoVista is null?"Número asignado al guardar o confirmar":(confirmadoVista.FechaSalidaUtc??confirmadoVista.FechaCreacionUtc).EnArgentina().ToString("dd/MM/yyyy HH:mm"))</div></div></header>
 <section class="remito-company"><div><strong>OXÍGENO NORTE</strong><br/>Santa Rosa, La Pampa</div><div><strong>Transporte:</strong> @modeloVista.Transporte<br/><strong>Estado:</strong> @(confirmadoVista is null||confirmadoVista.Estado=="Preparado"?"Pendiente de verificación":"Enviado")</div></section>
 <section class="remito-client"><span>DESTINO / CARGADORA</span><h2>@modeloVista.Destino</h2></section>
 <table class="remito-table"><colgroup><col style="width:30%"/><col style="width:15%"/><col style="width:20%"/><col style="width:35%"/></colgroup><thead><tr><th>Código del cilindro</th><th>Gas</th><th>Capacidad</th><th>Propietario</th></tr></thead><tbody>@foreach(var t in tubosVista){<tr><td>@t.Codigo</td><td>@t.Gas</td><td>@t.Capacidad</td><td>@t.Propietario</td></tr>}</tbody><tfoot><tr><td colspan="3"><strong>Total de tubos</strong></td><td><strong>@tubosVista.Count</strong></td></tr></tfoot></table>
 @if(!string.IsNullOrWhiteSpace(modeloVista.Observaciones)){<section class="remito-observations"><strong>Observaciones:</strong><p>@modeloVista.Observaciones</p></section>}
 </article></div>
 <div class="modal-footer">@if(confirmadoVista is null){<span class="text-muted me-auto">Al confirmar, estos tubos salen del stock de planta.</span><button class="btn btn-outline-secondary" disabled="@ocupado" @onclick="CerrarVista">Volver a editar</button><button class="btn btn-outline-primary" disabled="@ocupado" @onclick="GuardarVista">Guardar pendiente y descargar PDF</button><button class="btn btn-success" disabled="@ocupado" @onclick="ConfirmarVista">@(ocupado?"Confirmando...":"Confirmar envío")</button>}else{<button class="btn btn-outline-secondary" @onclick="CerrarVista">Cerrar</button><button class="btn btn-primary" @onclick="()=>Pdf(confirmadoVista.Id,null,confirmadoVista.Numero)">Descargar PDF</button>@if(confirmadoVista.Estado=="Preparado"){<button class="btn btn-outline-primary" disabled="@ocupado" @onclick="()=>EditarPendiente(confirmadoVista)">Cambiar tubos / datos</button><ConfirmarAccion Texto="Cancelar preparación" Mensaje="¿Cancelar el remito pendiente y liberar los tubos reservados?" OnConfirmar="CancelarVista"/><button class="btn btn-success" disabled="@ocupado" @onclick="ConfirmarVista">Confirmar envío</button>}}</div>
 </div></div></div>
}
@if(remitoViendo is not null){
 <div class="modal-backdrop show"></div><div class="modal d-block" role="dialog" aria-modal="true" aria-labelledby="tituloVerRemito" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content">
 <div class="modal-header"><h2 id="tituloVerRemito" class="modal-title h5">@remitoViendo.Tipo · @remitoViendo.Numero</h2><button class="btn-close" aria-label="Cerrar remito" @onclick="CerrarRemito"></button></div>
 <div class="modal-body p-0">@if(errorRemito is not null){<div class="alert alert-danger m-3">@errorRemito</div>}else if(pdfViendo is null){<p class="p-4" role="status">Cargando remito...</p>}else{<iframe src="@pdfViendo" title="Remito @remitoViendo.Numero" style="width:100%;height:70vh;border:0"></iframe>}</div>
 <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CerrarRemito">Cerrar</button><button class="btn btn-primary" @onclick="()=>Pdf(remitoViendo.EnvioId,remitoViendo.RecepcionId,remitoViendo.Numero)">Descargar PDF</button></div>
 </div></div></div>
}
@if(editandoPendiente is not null){<div class="modal-backdrop show"></div><div class="modal d-block" role="dialog" aria-modal="true" aria-labelledby="tituloCorregir"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 id="tituloCorregir" class="h5">Corregir @editandoPendiente.Numero</h2><button class="btn-close" disabled="@ocupado" aria-label="Cerrar" @onclick="CerrarEdicion"></button></div><div class="modal-body">@if(errorEdicion is not null){<div class="alert alert-danger">@errorEdicion</div>}<p>Los tubos quitados se liberan. Los agregados quedan reservados. El número del remito se conserva.</p><label class="form-label">Destino / cargadora</label><input class="form-control mb-2" maxlength="200" @bind="modeloEdicion.Destino"/><label class="form-label">Transporte</label><input class="form-control mb-2" maxlength="200" @bind="modeloEdicion.Transporte"/><label class="form-label">Observaciones</label><textarea class="form-control mb-3" maxlength="1000" @bind="modeloEdicion.Observaciones"></textarea>@foreach(var t in candidatosEdicion){<label class="d-block border-top py-2"><input type="checkbox" checked="@seleccionEdicion.Contains(t.Id)" @onchange="e=>MarcarEdicion(t.Id,(bool)(e.Value??false))"/> @t.Codigo · @t.Gas · @t.Capacidad</label>}</div><div class="modal-footer"><button class="btn btn-outline-secondary" disabled="@ocupado" @onclick="CerrarEdicion">Cancelar cambios</button><button class="btn btn-primary" disabled="@(ocupado||seleccionEdicion.Count==0)" @onclick="GuardarEdicion">Guardar cambios</button></div></div></div></div>}
@code{
 private void AbrirVistaPendiente(EnvioCargaDto e){detalle=null;confirmadoVista=e;errorVista=null;modeloVista=new(){Destino=e.Destino,Transporte=e.Transporte,Observaciones=e.Observaciones,TuboIds=e.Tubos.Select(t=>t.TuboId).ToList()};tubosVista=e.Tubos.Select(t=>new VacioCargaDto(t.TuboId,t.Codigo,t.Gas,t.Capacidad,"",false,"Reservado",t.ClientePropietarioId,t.Propietario)).ToList();mostrarVista=true;}
 private void CerrarEdicion(){if(ocupado)return;editandoPendiente=null;mostrarVista=confirmadoVista?.Estado=="Preparado";}
 private async Task CancelarVista(){if(ocupado||confirmadoVista is null)return;ocupado=true;errorVista=null;try{await Api.Cancelar(confirmadoVista.Id);await Cargar();mostrarVista=false;confirmadoVista=null;if(EnvioId.HasValue&&Preparando)Navigation.NavigateTo("cargas/preparar",replace:true);}catch(Exception ex){errorVista=ex.Message;}finally{ocupado=false;}}
 private static string EstadoCarga(string estado)=>estado=="Preparado"?"Pendiente de verificación":estado;
 private async Task GuardarVista(){if(ocupado)return;ocupado=true;errorVista=null;try{if(confirmadoVista is null){confirmadoVista=await Api.Crear(modeloVista);seleccion.Clear();nuevo=new();}var bytes=await Api.Pdf(confirmadoVista.Id);await JS.InvokeVoidAsync("descargarArchivoBase64",confirmadoVista.Numero+"-pendiente.pdf","application/pdf",Convert.ToBase64String(bytes));await Cargar();}catch(Exception ex){errorVista=ex.Message;}finally{ocupado=false;}}
 private EnvioCargaDto?editandoPendiente;private EnvioCargaCrearDto modeloEdicion=new();private List<VacioCargaDto>candidatosEdicion=[];private HashSet<int>seleccionEdicion=[];private string?errorEdicion;
 private void EditarPendiente(EnvioCargaDto e){mostrarVista=false;editandoPendiente=e;errorEdicion=null;seleccionEdicion=e.Tubos.Select(t=>t.TuboId).ToHashSet();modeloEdicion=new(){Destino=e.Destino,Transporte=e.Transporte,Observaciones=e.Observaciones};candidatosEdicion=vacios.Where(t=>t.Apto||seleccionEdicion.Contains(t.Id)).ToList();}
 private void MarcarEdicion(int id,bool marcado){if(marcado)seleccionEdicion.Add(id);else seleccionEdicion.Remove(id);}
 private async Task GuardarEdicion(){if(ocupado||editandoPendiente is null)return;ocupado=true;errorEdicion=null;try{modeloEdicion.TuboIds=seleccionEdicion.ToList();var e=await Api.Editar(editandoPendiente.Id,modeloEdicion);await Cargar();editandoPendiente=null;AbrirVistaPendiente(e);}catch(Exception ex){errorEdicion=ex.Message;}finally{ocupado=false;}}
 private DocumentoCarga?remitoViendo;private string?pdfViendo,errorRemito;private int solicitudRemito;
 private async Task VerRemito(DocumentoCarga remito){var solicitud=++solicitudRemito;remitoViendo=remito;pdfViendo=null;errorRemito=null;try{var bytes=await Api.Pdf(remito.EnvioId,remito.RecepcionId);if(solicitud==solicitudRemito)pdfViendo="data:application/pdf;base64,"+Convert.ToBase64String(bytes);}catch{if(solicitud==solicitudRemito)errorRemito="No se pudo cargar el remito. Cerrá la ventana e intentá nuevamente.";}}
 private void CerrarRemito(){solicitudRemito++;remitoViendo=null;pdfViendo=null;errorRemito=null;}
 private bool mostrarVista;private string?errorVista;private EnvioCargaDto?confirmadoVista;private EnvioCargaCrearDto modeloVista=new();private List<VacioCargaDto>tubosVista=[];
 private void CerrarVista(){if(!ocupado){mostrarVista=false;if(EnvioId.HasValue&&Preparando)Navigation.NavigateTo("cargas/preparar",replace:true);}}
 private async Task ConfirmarVista(){if(ocupado||(confirmadoVista is not null&&confirmadoVista.Estado!="Preparado"))return;ocupado=true;errorVista=null;try{confirmadoVista=confirmadoVista is null?await Api.ConfirmarEnvio(modeloVista):await Api.Salida(confirmadoVista.Id);seleccion.Clear();nuevo=new();try{await Cargar();}catch{errorVista="El envío quedó confirmado, pero no se pudo actualizar el stock. Usá Actualizar al cerrar.";}}catch(Exception ex){errorVista=ex.Message;}finally{ocupado=false;}}
 [Parameter]public long?EnvioId{get;set;}
 [SupplyParameterFromQuery(Name="envioId")]public long?FiltroEnvioId{get;set;}
 private string Seccion=>Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("cargas/pendientes")?"pendientes":Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("cargas/historial")?"historial":Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("cargas/envios")?"envios":"stock";
 private bool Preparando=>Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].StartsWith("cargas/preparar");
 private string Titulo=>Preparando?"Preparar envío a carga":Seccion=="historial"?"Historial de cargas":Seccion=="pendientes"?"Envíos pendientes":Seccion=="envios"?"Recibir tubos":"Stock de vacíos";
 private string panelDetalle="detalle";private int paginaVacios=1,paginaEnvios=1,paginaHistorial=1,paginaDetalle=1,paginaRetornos=1;
 private string buscarVacio="",condicionVacio="Todos",buscarEnvio="",buscarHistorial="",tipoHistorial="Todos",buscarRetorno="";
 private string BuscarVacio{get=>buscarVacio;set{buscarVacio=value;paginaVacios=1;}}
 private string CondicionVacio{get=>condicionVacio;set{condicionVacio=value;paginaVacios=1;}}
 private string BuscarEnvio{get=>buscarEnvio;set{buscarEnvio=value;paginaEnvios=1;}}
 private string BuscarHistorial{get=>buscarHistorial;set{buscarHistorial=value;paginaHistorial=1;}}
 private string TipoHistorial{get=>tipoHistorial;set{tipoHistorial=value;paginaHistorial=1;}}
 private string BuscarRetorno{get=>buscarRetorno;set{buscarRetorno=value;paginaRetornos=1;}}
 private static bool Coincide(string buscar,params string[] valores)=>string.IsNullOrWhiteSpace(buscar)||valores.Any(v=>v.Contains(buscar.Trim(),StringComparison.OrdinalIgnoreCase));
 private List<VacioCargaDto> VaciosFiltrados=>vacios.Where(t=>BusquedaTubos.Coincide(buscarVacio,t.Gas,t.Codigo,t.Capacidad,t.Ubicacion,t.Propietario)&&(condicionVacio=="Todos"||(condicionVacio=="Aptos"?t.Apto:!t.Apto))).ToList();
 private IEnumerable<VacioCargaDto> VaciosPagina=>PaginaDe(VaciosFiltrados,paginaVacios);
 private List<EnvioCargaDto> EnviosFiltrados=>envios.Where(e=>(Preparando||Seccion=="pendientes")?e.Estado=="Preparado":e.Estado is "Enviado" or "Parcial").Where(e=>Coincide(buscarEnvio,e.Numero,e.Destino,e.Transporte)).ToList();
 private IEnumerable<EnvioCargaDto> EnviosPagina=>PaginaDe(EnviosFiltrados,paginaEnvios);
 private IEnumerable<EnvioCargaTuboDto> DetallesPagina=>PaginaDe(detalle?.Tubos.ToList()??[],paginaDetalle);
 private List<EnvioCargaTuboDto> RetornosFiltrados=>(detalle?.Tubos??[]).Where(t=>t.Estado=="Pendiente"&&BusquedaTubos.Coincide(buscarRetorno,t.Gas,t.Codigo)).ToList();
 private IEnumerable<EnvioCargaTuboDto> RetornosPagina=>PaginaDe(RetornosFiltrados,paginaRetornos);
 private static IEnumerable<T> PaginaDe<T>(List<T> lista,int pagina)=>lista.Skip((Math.Clamp(pagina,1,Math.Max(1,(lista.Count+24)/25))-1)*25).Take(25);
 private void CambiarPanel(bool recibir)=>panelDetalle=recibir?"recepcion":"detalle";
 private sealed record DocumentoCarga(long EnvioId,long?RecepcionId,string Numero,string Tipo,DateTime Fecha,string Destino,string Transporte,string Estado,string EnvioNumero,int Cantidad,string Codigos);
 private List<DocumentoCarga> HistorialFiltrado=>envios.SelectMany(e=>new[]{new DocumentoCarga(e.Id,null,e.Numero,"Envío",e.FechaSalidaUtc??e.FechaCreacionUtc,e.Destino,e.Transporte,e.Estado,e.Numero,e.Tubos.Count,string.Join(" ",e.Tubos.Select(t=>t.Codigo)))}.Concat(e.Recepciones.Select(r=>new DocumentoCarga(e.Id,r.Id,r.Numero,"Recepción",r.FechaUtc,e.Destino,e.Transporte,"Confirmado",e.Numero,r.Tubos.Count,string.Join(" ",r.Tubos.Select(t=>t.Codigo)))))).Where(r=>(!FiltroEnvioId.HasValue||r.EnvioId==FiltroEnvioId)&&(tipoHistorial=="Todos"||r.Tipo==tipoHistorial)&&Coincide(buscarHistorial,r.Numero,r.EnvioNumero,r.Destino,r.Transporte,r.Codigos)).OrderByDescending(r=>r.Fecha).ToList();
 private IEnumerable<DocumentoCarga> HistorialPagina=>PaginaDe(HistorialFiltrado,paginaHistorial);

 private List<VacioCargaDto>vacios=[];private List<EnvioCargaDto>envios=[];private List<UbicacionDto>ubicaciones=[];private HashSet<int>seleccion=[];private Dictionary<long,string>retornos=[];private EnvioCargaDto?detalle;private EnvioCargaCrearDto nuevo=new();private RecepcionCargaCrearDto recepcion=new();private ResolucionCargaDto faltante=new();private bool ocupado;private string?error;
 protected override async Task OnParametersSetAsync(){if(Seccion=="pendientes"){Navigation.NavigateTo(EnvioId.HasValue?$"cargas/preparar/{EnvioId}":"cargas/preparar",replace:true);return;}condicionVacio=Preparando?"Aptos":"Todos";await Actualizar();if((Seccion=="envios"||Preparando)&&EnvioId.HasValue){var e=envios.FirstOrDefault(x=>x.Id==EnvioId);if(e is not null){if(e.Estado=="Preparado"&&Seccion=="envios"){Navigation.NavigateTo($"cargas/preparar/{e.Id}",replace:true);return;}if(e.Estado=="Preparado")AbrirVistaPendiente(e);else Mostrar(e);}else error="No se encontró el envío.";}else detalle=null;}
 private async Task Actualizar(){ocupado=true;error=null;try{await Cargar();}catch(Exception ex){error=ex.Message;}finally{ocupado=false;}}
 private async Task Cargar(){vacios=await Api.Vacios();envios=await Api.Envios();ubicaciones=(await Catalogos.UbicacionesAsync()).Where(x=>x.EsInterna&&x.GasBateria==null).ToList();seleccion.IntersectWith(vacios.Where(x=>x.Apto).Select(x=>x.Id));if(detalle is not null)detalle=envios.FirstOrDefault(x=>x.Id==detalle.Id);}
 private void Marcar(int id,bool v){if(v)seleccion.Add(id);else seleccion.Remove(id);}
 private void SeleccionarTodos(){var ids=VaciosFiltrados.Where(x=>x.Apto).Select(x=>x.Id).ToList();if(ids.Count>0&&ids.All(seleccion.Contains))seleccion.ExceptWith(ids);else seleccion.UnionWith(ids);}
 private void Abrir(EnvioCargaDto e){if(e.Estado=="Preparado"){AbrirVistaPendiente(e);return;}Mostrar(e);Navigation.NavigateTo($"cargas/envios/{e.Id}");}
 private void Mostrar(EnvioCargaDto e){buscarRetorno="";paginaDetalle=paginaRetornos=1;panelDetalle=e.Estado is "Enviado" or "Parcial"?"recepcion":"detalle";detalle=e;retornos.Clear();faltante=new();recepcion=new(){UbicacionDestinoId=ubicaciones.FirstOrDefault(x=>x.Nombre=="Planta")?.Id??ubicaciones.FirstOrDefault()?.Id??0};}
 private bool ValidarEnvio(EditContext contexto){nuevo.TuboIds=seleccion.ToList();return contexto.Validate();}
 private async Task PrepararEnvio(EditContext contexto){if(ValidarEnvio(contexto))await Crear();}
 private Task Crear(){error=null;errorVista=null;confirmadoVista=null;modeloVista=new(){Destino=nuevo.Destino,Transporte=nuevo.Transporte,Observaciones=nuevo.Observaciones,TuboIds=nuevo.TuboIds.ToList()};tubosVista=vacios.Where(t=>modeloVista.TuboIds.Contains(t.Id)).ToList();mostrarVista=true;return Task.CompletedTask;}
 private bool ValidarRecepcion(EditContext contexto){recepcion.Tubos=retornos.Select(x=>new RecepcionCargaItemDto{DetalleId=x.Key,Resultado=x.Value}).ToList();return contexto.Validate();}
 private async Task PrepararRecepcion(EditContext contexto){if(ValidarRecepcion(contexto))await Recibir();}
 private async Task Recibir(){if(detalle is null)return;await Ejecutar(()=>Api.Recibir(detalle.Id,recepcion));}
 private async Task Resolver(){if(detalle is null)return;await Ejecutar(()=>Api.Resolver(detalle.Id,faltante));}
 private async Task Ejecutar(Func<Task<EnvioCargaDto>> accion){if(ocupado)return;ocupado=true;error=null;try{var e=await accion();await Cargar();Abrir(e);}catch(Exception ex){error=ex.Message;}finally{ocupado=false;}}
 private void CambiarResultado(long id,ChangeEventArgs e)=>retornos[id]=e.Value?.ToString()??"Lleno";
 private void MarcarRetorno(long id,bool v){if(v)retornos[id]="Lleno";else retornos.Remove(id);}

 private void MarcarRetornos(EnvioCargaDto e){foreach(var t in RetornosFiltrados)retornos.TryAdd(t.Id,"Lleno");}
 private async Task Pdf(long id,long?r,string numero){try{var bytes=await Api.Pdf(id,r);await JS.InvokeVoidAsync("descargarArchivoBase64",numero+".pdf","application/pdf",Convert.ToBase64String(bytes));}catch(Exception ex){error=ex.Message;}}
 private static int DiasFuera(EnvioCargaDto e)=>(HoraArgentina.Hoy-e.FechaSalidaUtc!.Value.EnArgentina().Date).Days;
