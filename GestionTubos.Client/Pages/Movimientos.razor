@page "/movimientos"
@attribute [Authorize]
@inject GestionTubos.Client.Services.OperacionApiService Api
<PageTitle>Movimientos</PageTitle><h1>Historial de movimientos</h1><p class="text-muted">Registro cronológico e inalterable de cada cambio.@if(CilindroId.HasValue){<span> Mostrando únicamente el cilindro seleccionado.</span>}</p>
@if(error is not null){<div class="alert alert-danger">@error</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Fecha</th><th>Cilindro</th><th>Movimiento</th><th>Origen → destino</th><th>Cliente</th><th>Observaciones</th></tr></thead><tbody>@if(items.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">No hay movimientos para mostrar.</td></tr>}@foreach(var x in items){<tr><td>@x.FechaHoraUtc.EnArgentina().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@x.CodigoCilindro</strong></td><td>@x.Tipo</td><td>@x.Origen → @x.Destino</td><td>@x.Cliente</td><td>@x.Observaciones</td></tr>}</tbody></table></div></div>
@code{[SupplyParameterFromQuery(Name="cilindroId")]public int?CilindroId{get;set;}private List<MovimientoDto>items=[];private string?error;protected override async Task OnInitializedAsync(){try{items=await Api.Movimientos(CilindroId);}catch(Exception e){error=e.Message;}}}
