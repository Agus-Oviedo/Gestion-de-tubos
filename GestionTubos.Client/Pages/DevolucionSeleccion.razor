@page "/devoluciones/remito/{RemitoId:long}"
@attribute [Authorize]
@inject OperacionApiService Api
@inject CatalogoApiService Catalogos
@inject NavigationManager Navigation
<PageTitle>Crear remito de devolución</PageTitle>
<h1>Remito de devolución</h1>
@if(cargando){<p>Cargando...</p>}else if(operaciones.Count==0){<div class="alert alert-warning">Este remito no tiene tubos pendientes.</div>}else{
<p><strong>Entrega @operaciones[0].NumeroRemitoEntrega</strong> · @operaciones[0].Cliente</p>
@if(!string.IsNullOrWhiteSpace(error)){<div class="alert alert-danger">@error</div>}
<EditForm Model="modelo" OnValidSubmit="Continuar"><DataAnnotationsValidator/><ValidationSummary/>
<div class="card card-body shadow-sm mb-4"><h2 class="h5">Seleccioná los tubos que devuelve ahora</h2>@foreach(var x in operaciones){<label @key="x.Id" class="form-check py-2 border-bottom"><input type="checkbox" class="form-check-input" checked="@modelo.OperacionIds.Contains(x.Id)" @onchange="e=>Marcar(x.Id,(bool)(e.Value??false))"/><span class="ms-2"><strong>@x.CodigoCilindro</strong><span class="d-block d-sm-inline text-muted"> · @x.Gas · @x.Capacidad</span></span></label>}</div>
<div class="mt-3"><button class="btn btn-primary">Confirmar tubos y pasar a firma</button> <a class="btn btn-outline-secondary" href="recepciones">Cancelar</a></div>
</EditForm>}
@code{
 [Parameter]public long RemitoId{get;set;}private bool cargando=true;private string?error;private List<OperacionDto>operaciones=[];private List<UbicacionDto>ubicaciones=[];private DevolucionLoteCrearDto modelo=new();
 protected override async Task OnInitializedAsync(){operaciones=(await Api.Operaciones(true)).Where(x=>x.RemitoEntregaId==RemitoId).ToList();ubicaciones=(await Catalogos.UbicacionesAsync()).Where(x=>x.EsInterna&&x.GasBateria==null).ToList();modelo.RemitoEntregaId=RemitoId;modelo.OperacionIds=operaciones.Select(x=>x.Id).ToList();modelo.UbicacionDestinoId=ubicaciones.FirstOrDefault(x=>x.Nombre.Equals("Planta",StringComparison.OrdinalIgnoreCase))?.Id??ubicaciones.FirstOrDefault()?.Id??0;modelo.EstadoFisico=1;modelo.EstadoContenido=2;modelo.RequiereInspeccion=false;cargando=false;}
 private void Marcar(long id,bool v){if(v&&!modelo.OperacionIds.Contains(id))modelo.OperacionIds.Add(id);else if(!v)modelo.OperacionIds.Remove(id);}
 private async Task Continuar(){try{error=null;var x=await Api.CrearDevolucionLote(modelo);Navigation.NavigateTo($"devoluciones/{x.Id}/firma");}catch(Exception ex){error=ex.Message;}}
}
