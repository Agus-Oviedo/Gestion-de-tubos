@page "/"
@attribute [Authorize]
@inject TuboApiService Api
@inject CatalogoApiService Catalogos

<PageTitle>Resumen de stock</PageTitle>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><span class="stock-eyebrow">OXÍGENO NORTE</span><h1 class="mt-2 mb-1">Control de stock</h1><p class="text-muted mb-0">Vista general de los tubos registrados en el sistema.</p></div>
    <AuthorizeView Roles="Superadministrador,Administrador"><a class="btn btn-primary btn-lg" href="cilindros/nuevo">＋ Cargar tubo</a></AuthorizeView>
</div>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
else if (cargando) { <p>Cargando stock...</p> }
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat"><span>Total registrados</span><strong>@tubos.Count</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--ok"><span>Llenos disponibles</span><strong>@LlenosDisponibles</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--warn"><span>Vacíos en planta</span><strong>@VaciosEnPlanta</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--use"><span>En carga externa</span><strong>@Contar(12)</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--use"><span>Con clientes</span><strong>@Contar(4)</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--use"><span>En batería</span><strong>@Contar(13)</strong></div></div>
        <div class="col-6 col-md-4 col-xl-3"><div class="stock-stat stock-stat--warn"><span>Mantenimiento</span><strong>@Contar(7)</strong></div></div>
    </div>
    <div class="row g-4">
        <div class="col-lg-7"><div class="card h-100"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Stock por gas</h2><a href="cilindros" class="btn btn-sm btn-outline-primary">Ver todos</a></div>
            @if (tubos.Count == 0) { <div class="empty-stock"><strong>Todavía no hay tubos cargados.</strong><span>Registrá el primero para comenzar a controlar el stock.</span></div> }
            else
            {
                @foreach (var grupo in tubos.GroupBy(x => x.Gas).OrderByDescending(x => x.Count()))
                {
                    var porcentaje = (int)Math.Round(grupo.Count() * 100d / tubos.Count);
                    <div class="stock-group mb-3"><div class="d-flex justify-content-between mb-1"><strong>@grupo.Key</strong><span>@grupo.Count() tubos</span></div><div class="progress"><div class="progress-bar" style="width:@porcentaje%"></div></div></div>
                }
            }
        </div></div></div>
        <div class="col-lg-5"><div class="card h-100"><div class="card-body">
            <h2 class="h4 mb-3">Stock por ubicación</h2>
            @foreach (var grupo in tubos.GroupBy(x => x.Ubicacion).OrderByDescending(x => x.Count())) { <div class="d-flex justify-content-between align-items-center py-2 border-bottom"><span>@grupo.Key</span><strong class="location-count">@grupo.Count()</strong></div> }
            @if (tubos.Count == 0) { <p class="text-muted mb-0">Sin ubicaciones con tubos registrados.</p> }
        </div></div></div>
    </div>
}

@code {
    private List<TuboDto> tubos = [];
    private HashSet<int> ubicacionesInternas = [];
    private int LlenosDisponibles => tubos.Count(x => x.EstadoDisponibilidad == 1 && x.EstadoContenido == 1);
    private int VaciosEnPlanta => tubos.Count(x => x.TipoPropietario == 1 && x.EstadoContenido == 2 && ubicacionesInternas.Contains(x.UbicacionId) && x.EstadoDisponibilidad is not (9 or 10));
    private bool cargando = true;
    private string? error;
    protected override async Task OnInitializedAsync() { try { var tareaTubos=Api.Todos();var tareaUbicaciones=Catalogos.UbicacionesAsync();await Task.WhenAll(tareaTubos,tareaUbicaciones);tubos=await tareaTubos;ubicacionesInternas=(await tareaUbicaciones).Where(x=>x.EsInterna).Select(x=>x.Id).ToHashSet(); } catch (Exception ex) { error = ex.Message; } finally { cargando = false; } }
    private int Contar(int estado) => tubos.Count(x => x.EstadoDisponibilidad == estado);
}
