@page "/pedidos"
@attribute [Authorize]
@inject PedidoApiService Api
@inject ClienteApiService ClientesApi
@inject TuboApiService CilindrosApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Remitos de entrega</PageTitle><h1>Remitos de entrega</h1><p class="text-muted">Elegí el cliente y los tubos que se lleva. El remito se crea y los tubos quedan reservados hasta confirmar la entrega.</p>
@if(!string.IsNullOrWhiteSpace(mensaje)){<div class="alert @(esError?"alert-danger":"alert-success")">@mensaje</div>}
<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h4">Nuevo remito de entrega</h2><EditForm Model="nuevo" OnValidSubmit="Crear"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-5"><div class="d-flex justify-content-between align-items-center"><label class="form-label">Cliente</label><AuthorizeView Roles="Superadministrador,Administrador" Context="altaClientePedidoRol"><a class="btn btn-sm btn-outline-primary mb-1" href="clientes/nuevo?volver=pedidos">+ Nuevo cliente</a></AuthorizeView></div><ClienteBuscador Clientes="clientes" ClienteId="nuevo.ClienteId" ClienteIdChanged="CambiarCliente"/></div><div class="col-md-3"><label class="form-label">Lugar de entrega</label><InputSelect class="form-select" @bind-Value="ModalidadEntrega"><option value="RetiroPlanta">Retiro en planta</option><option value="Domicilio">Entrega a domicilio</option></InputSelect></div><div class="col-md-4"><label class="form-label">Fecha prevista</label><InputDate class="form-control" @bind-Value="nuevo.FechaPrevistaEntrega"/></div>
@if(nuevo.ModalidadEntrega=="Domicilio"){<div class="col-md-6"><label class="form-label">Dirección de entrega</label><InputSelect class="form-select" @bind-Value="nuevo.DireccionEntregaId"><option value="">Seleccionar</option>@foreach(var d in direcciones){<option value="@d.Id">@Direccion(d)</option>}</InputSelect>@if(nuevo.ClienteId>0&&direcciones.Count==0){<small class="text-danger">El cliente no tiene direcciones registradas. Cargala desde su ficha.</small>}</div>}else{<div class="col-md-6"><div class="alert alert-info mb-0 py-2">El cliente retira en planta. El pedido no ingresará a Repartos.</div></div>}<div class="col-md-3"><label class="form-label">Contacto</label><InputText class="form-control" @bind-Value="nuevo.ContactoEntrega"/></div><div class="col-md-3"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="nuevo.TelefonoEntrega"/></div><div class="col-12"><label class="form-label">Descripción / observaciones</label><InputTextArea class="form-control" rows="3" maxlength="1000" placeholder="Ej.: pagó en efectivo, queda pendiente de pago u otra aclaración." @bind-Value="nuevo.Observaciones"/><small class="text-muted">Se incluye en el remito y en el PDF. Hasta 1000 caracteres.</small></div></div>
<div class="d-flex justify-content-between align-items-end mt-3 mb-2"><label class="form-label mb-0">Cilindros habilitados para este cliente</label>@if(nuevo.CilindroIds.Count>0){<span class="badge bg-primary">@nuevo.CilindroIds.Count seleccionado@(nuevo.CilindroIds.Count==1?"":"s")</span>}</div>
@if(nuevo.ClienteId>0&&DisponiblesParaCliente.Count>0){<input type="search" class="form-control mb-2" placeholder="Buscar por código, serie, gas, capacidad o propietario..." @bind="buscarCilindro" @bind:event="oninput"/>}
<div class="cylinder-picker">@if(nuevo.ClienteId==0){<span class="text-muted">Primero seleccioná un cliente.</span>}else if(DisponiblesParaCliente.Count==0){<span class="text-muted">No hay cilindros disponibles habilitados para este cliente.</span>}else if(CilindrosFiltrados.Count==0){<span class="text-muted">No hay cilindros que coincidan con la búsqueda.</span>}@foreach(var c in CilindrosFiltrados){<label @key="c.Id" class="form-check"><input class="form-check-input" type="checkbox" checked="@nuevo.CilindroIds.Contains(c.Id)" @onchange="e=>Seleccionar(c.Id,(bool)(e.Value??false))"/><span class="form-check-label"><strong>@c.CodigoInterno</strong> · @c.Gas · @c.Capacidad · @c.Propietario</span></label>}</div>
<div class="alert alert-light border mt-4 mb-0"><strong>Siguiente paso:</strong> después de confirmar estos datos se abrirá una pantalla separada para que el cliente complete su aclaración, DNI y firma.</div><button class="btn btn-primary btn-lg mt-3">Confirmar datos y pasar al cliente</button></EditForm></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Remito</th><th>Cliente</th><th>Entrega</th><th>Cilindros</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in pedidos){<tr><td>@if(p.NumeroRemito is not null){<a class="fw-bold" href="@($"remitos/{p.Id}")">@p.NumeroRemito</a>}else{<span class="text-muted">Registro anterior sin remito</span>}<br/><small>@p.FechaHoraUtc.EnArgentina().ToString("dd/MM/yyyy HH:mm")</small></td><td>@p.Cliente</td><td><strong>@(p.ModalidadEntrega=="Domicilio"?"A domicilio":"Retiro en planta")</strong><br/><small>@p.DireccionEntregaTexto @if(p.FechaPrevistaEntrega.HasValue){<span>· @p.FechaPrevistaEntrega.Value.ToString("dd/MM/yyyy")</span>}</small></td><td>@string.Join(", ",p.Cilindros.Select(x=>x.Codigo))</td><td><span class="badge bg-warning text-dark">@(p.Estado=="Preparado"?"Pendiente de firma del cliente":p.Estado)</span></td><td><div class="d-flex gap-1">@if(p.NumeroRemito is null){<button class="btn btn-sm btn-primary" @onclick="()=>Emitir(p.Id)">Crear remito</button>}else{<a class="btn btn-sm btn-outline-secondary" href="@($"remitos/{p.Id}")">Ver</a>}@if(p.Estado is "Preparado" or "En reparto"){<button class="btn btn-sm btn-success" @onclick="()=>PrepararEntrega(p)">Continuar con el cliente</button>}@if(p.NumeroRemito is not null&&p.Estado=="Preparado"){<AuthorizeView Roles="Superadministrador,Administrador" Context="eliminarRemitoRol"><button class="btn btn-sm btn-outline-danger" @onclick="()=>Eliminar(p)">Eliminar</button></AuthorizeView>}</div></td></tr>}</tbody></table></div></div>
@code{
 [SupplyParameterFromQuery(Name="clienteId")]public int?ClienteIdInicial{get;set;}
 private PedidoCrearDto nuevo=NuevoPedido();private List<PedidoDto>pedidos=[];private List<ClienteDto>clientes=[];private List<DireccionClienteDto>direcciones=[];private List<TuboDto>disponibles=[];private string buscarCilindro="";private string?mensaje;private bool esError;
 private static PedidoCrearDto NuevoPedido()=>new(){FechaPrevistaEntrega=DateOnly.FromDateTime(GestionTubos.Shared.HoraArgentina.Hoy)};
 private List<TuboDto>DisponiblesParaCliente=>nuevo.ClienteId==0?[]:disponibles.Where(x=>x.TipoPropietario!=2||x.ClientePropietarioId==nuevo.ClienteId).ToList();
 private List<TuboDto>CilindrosFiltrados=>DisponiblesParaCliente.Where(x=>nuevo.CilindroIds.Contains(x.Id)||CoincideBusqueda(x)).OrderByDescending(x=>nuevo.CilindroIds.Contains(x.Id)).ThenBy(x=>x.CodigoInterno).ToList();
 private bool CoincideBusqueda(TuboDto x)=>BusquedaTubos.Coincide(buscarCilindro,x.Gas,x.CodigoInterno,x.NumeroSerie,x.IdentificacionGrabada,x.Capacidad,x.Propietario);
 private int ClienteSeleccionado{get=>nuevo.ClienteId;set{nuevo.ClienteId=value;buscarCilindro="";nuevo.CilindroIds.RemoveAll(id=>!disponibles.Any(x=>x.Id==id&&(x.TipoPropietario!=2||x.ClientePropietarioId==value)));}}
 private async Task CambiarCliente(int?id){ClienteSeleccionado=id??0;await CargarDirecciones();}
 private string ModalidadEntrega{get=>nuevo.ModalidadEntrega;set{nuevo.ModalidadEntrega=value;if(value!="Domicilio")nuevo.DireccionEntregaId=null;}}
 protected override async Task OnInitializedAsync(){clientes=(await ClientesApi.ObtenerTodosAsync()).ToList();await Cargar();if(ClienteIdInicial.HasValue&&clientes.Any(x=>x.Id==ClienteIdInicial)){ClienteSeleccionado=ClienteIdInicial.Value;await CargarDirecciones();}}
 private async Task Cargar(){pedidos=(await Api.Obtener()).Where(x=>x.Estado!="Entregado").ToList();disponibles=(await CilindrosApi.Todos()).Where(x=>x.EstadoDisponibilidad==1&&((x.TipoPropietario is not (1 or 2))||x.EstadoContenido==1)&&(x.TipoPropietario!=2||x.IngresoClienteAbierto)).ToList();}
 private async Task CargarDirecciones(){direcciones=nuevo.ClienteId>0?(await ClientesApi.ObtenerDireccionesAsync(nuevo.ClienteId)).ToList():[];nuevo.DireccionEntregaId=direcciones.FirstOrDefault(x=>x.EsPrincipalEntrega)?.Id??direcciones.FirstOrDefault()?.Id;}
 private static string Direccion(DireccionClienteDto d)=>$"{d.Calle} {d.Numero}, {d.Localidad}, {d.Provincia}".Replace("  "," ");
 private void Seleccionar(int id,bool marcado){if(marcado&&!nuevo.CilindroIds.Contains(id))nuevo.CilindroIds.Add(id);else if(!marcado)nuevo.CilindroIds.Remove(id);}
 private async Task Crear(){try{esError=false;mensaje=null;var creado=await Api.Crear(nuevo);Navigation.NavigateTo($"remitos/{creado.Id}/firma");}catch(Exception e){esError=true;mensaje=e.Message;}}
 private Task Emitir(long id)=>Ejecutar(async()=>{await Api.EmitirRemito(id);mensaje="El registro anterior ya tiene su remito.";});
 private async Task Eliminar(PedidoDto p){var motivo=await JS.InvokeAsync<string?>("prompt",$"Motivo para eliminar el remito {p.NumeroRemito}. Los tubos volverán al stock disponible:");if(string.IsNullOrWhiteSpace(motivo))return;await Ejecutar(async()=>{await Api.EliminarRemito(p.Id,motivo);mensaje=$"Remito {p.NumeroRemito} eliminado. Los tubos volvieron al stock.";});}
 private void PrepararEntrega(PedidoDto p)=>Navigation.NavigateTo($"remitos/{p.Id}/firma");
 private async Task Ejecutar(Func<Task>f){try{esError=false;mensaje=null;await f();await Cargar();}catch(Exception e){esError=true;mensaje=e.Message;}}
}
