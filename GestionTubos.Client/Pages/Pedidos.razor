@page "/pedidos"
@attribute [Authorize]
@inject PedidoApiService Api
@inject ClienteApiService ClientesApi
@inject TuboApiService CilindrosApi
@inject IJSRuntime JS
<PageTitle>Pedidos y entregas</PageTitle><h1>Pedidos y entregas</h1><p class="text-muted">Definí si el cliente retira en planta o si el pedido debe incorporarse a un reparto.</p>
@if(!string.IsNullOrWhiteSpace(mensaje)){<div class="alert @(esError?"alert-danger":"alert-success")">@mensaje</div>}
@if(pedidoAEntregar is not null){<div class="card border-primary shadow-sm mb-4"><div class="card-body"><h2 class="h4">Confirmar entrega de @pedidoAEntregar.Numero</h2><p>@pedidoAEntregar.Cliente · @(pedidoAEntregar.ModalidadEntrega=="Domicilio"?"Entrega a domicilio":"Retiro en planta") · @pedidoAEntregar.NumeroRemito</p><EditForm Model="entrega" OnValidSubmit="ConfirmarEntrega"><DataAnnotationsValidator/><ValidationSummary/>@if(EsDevolucionPropia(pedidoAEntregar)){<div class="alert alert-info"><strong>Devolución de cilindro propio.</strong> No genera alquiler, comodato ni días sin cargo.</div>}<div class="row g-3">@if(!EsDevolucionPropia(pedidoAEntregar)){<div class="col-md-3"><label class="form-label">Modalidad comercial</label><InputSelect class="form-select" @bind-Value="entrega.Modalidad"><option>Alquiler</option><option>Comodato</option><option>Intercambio</option></InputSelect></div><div class="col-md-2"><label class="form-label">Días sin cargo</label><InputNumber class="form-control" @bind-Value="entrega.DiasSinCargo"/></div>}<div class="col-md-4"><label class="form-label">Persona que recibe</label><InputText class="form-control" @bind-Value="entrega.PersonaRecibe"/></div><div class="col-md-3"><label class="form-label">DNI</label><InputText class="form-control" inputmode="numeric" @bind-Value="entrega.DniRecibe"/></div><div class="col-md-5"><label class="form-label">Observaciones</label><InputText class="form-control" @bind-Value="entrega.Observaciones"/></div><div class="col-12"><div class="d-flex justify-content-between align-items-center mb-2"><label class="form-label fw-bold mb-0">Firma de quien recibe</label><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFirma">Limpiar firma</button></div><canvas id="firma-entrega" class="signature-canvas w-100" aria-label="Área para firmar con el dedo"></canvas><div class="form-text">Firmá dentro del recuadro usando el dedo o un lápiz táctil.</div></div></div><div class="mt-3"><button class="btn btn-success btn-lg me-2">Confirmar y firmar remito</button><button type="button" class="btn btn-outline-secondary btn-lg" @onclick="CancelarEntrega">Cancelar</button></div></EditForm></div></div>}
<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h4">Nuevo pedido</h2><EditForm Model="nuevo" OnValidSubmit="Crear"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-5"><div class="d-flex justify-content-between align-items-center"><label class="form-label">Cliente</label><AuthorizeView Roles="Superadministrador,Administrador" Context="altaClientePedidoRol"><a class="btn btn-sm btn-outline-primary mb-1" href="clientes/nuevo?volver=pedidos">+ Nuevo cliente</a></AuthorizeView></div><ClienteBuscador Clientes="clientes" ClienteId="nuevo.ClienteId" ClienteIdChanged="CambiarCliente"/></div><div class="col-md-3"><label class="form-label">Lugar de entrega</label><InputSelect class="form-select" @bind-Value="ModalidadEntrega"><option value="RetiroPlanta">Retiro en planta</option><option value="Domicilio">Entrega a domicilio</option></InputSelect></div><div class="col-md-4"><label class="form-label">Fecha prevista</label><InputDate class="form-control" @bind-Value="nuevo.FechaPrevistaEntrega"/></div>
@if(nuevo.ModalidadEntrega=="Domicilio"){<div class="col-md-6"><label class="form-label">Dirección de entrega</label><InputSelect class="form-select" @bind-Value="nuevo.DireccionEntregaId"><option value="">Seleccionar</option>@foreach(var d in direcciones){<option value="@d.Id">@Direccion(d)</option>}</InputSelect>@if(nuevo.ClienteId>0&&direcciones.Count==0){<small class="text-danger">El cliente no tiene direcciones registradas. Cargala desde su ficha.</small>}</div>}else{<div class="col-md-6"><div class="alert alert-info mb-0 py-2">El cliente retira en planta. El pedido no ingresará a Repartos.</div></div>}<div class="col-md-3"><label class="form-label">Contacto</label><InputText class="form-control" @bind-Value="nuevo.ContactoEntrega"/></div><div class="col-md-3"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="nuevo.TelefonoEntrega"/></div><div class="col-12"><label class="form-label">Observaciones</label><InputText class="form-control" @bind-Value="nuevo.Observaciones"/></div></div>
<div class="d-flex justify-content-between align-items-end mt-3 mb-2"><label class="form-label mb-0">Cilindros habilitados para este cliente</label>@if(nuevo.CilindroIds.Count>0){<span class="badge bg-primary">@nuevo.CilindroIds.Count seleccionado@(nuevo.CilindroIds.Count==1?"":"s")</span>}</div>
@if(nuevo.ClienteId>0&&DisponiblesParaCliente.Count>0){<input type="search" class="form-control mb-2" placeholder="Buscar por código, serie, gas, capacidad o propietario..." @bind="buscarCilindro" @bind:event="oninput"/>}
<div class="cylinder-picker">@if(nuevo.ClienteId==0){<span class="text-muted">Primero seleccioná un cliente.</span>}else if(DisponiblesParaCliente.Count==0){<span class="text-muted">No hay cilindros disponibles habilitados para este cliente.</span>}else if(CilindrosFiltrados.Count==0){<span class="text-muted">No hay cilindros que coincidan con la búsqueda.</span>}@foreach(var c in CilindrosFiltrados){<label class="form-check"><input class="form-check-input" type="checkbox" checked="@nuevo.CilindroIds.Contains(c.Id)" @onchange="e=>Seleccionar(c.Id,(bool)(e.Value??false))"/><span class="form-check-label"><strong>@c.CodigoInterno</strong> · @c.Gas · @c.Capacidad · @c.Propietario</span></label>}</div><button class="btn btn-primary mt-3">Crear pedido</button></EditForm></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Pedido</th><th>Cliente</th><th>Entrega</th><th>Cilindros</th><th>Estado</th><th>Remito</th><th></th></tr></thead><tbody>@foreach(var p in pedidos){<tr><td><strong>@p.Numero</strong><br/><small>@p.FechaHoraUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td><td>@p.Cliente</td><td><strong>@(p.ModalidadEntrega=="Domicilio"?"A domicilio":"Retiro en planta")</strong><br/><small>@p.DireccionEntregaTexto @if(p.FechaPrevistaEntrega.HasValue){<span>· @p.FechaPrevistaEntrega.Value.ToString("dd/MM/yyyy")</span>}</small></td><td>@string.Join(", ",p.Cilindros.Select(x=>x.Codigo))</td><td><span class="badge @(p.Estado=="Entregado"?"bg-success":"bg-info text-dark")">@p.Estado</span></td><td>@if(p.NumeroRemito is not null){<a class="fw-bold" href="@($"remitos/{p.Id}")">@p.NumeroRemito</a>}else{<span>—</span>}</td><td><div class="d-flex gap-1">@if(p.NumeroRemito is null){<button class="btn btn-sm btn-outline-primary" @onclick="()=>Emitir(p.Id)">Emitir remito</button>}else{<a class="btn btn-sm btn-outline-secondary" href="@($"remitos/{p.Id}")">Ver</a>}@if((p.ModalidadEntrega=="RetiroPlanta"&&p.Estado=="Preparado")||(p.ModalidadEntrega=="Domicilio"&&p.Estado=="En reparto")){<button class="btn btn-sm btn-success" @onclick="()=>PrepararEntrega(p)">Completar entrega</button>}else if(p.ModalidadEntrega=="Domicilio"&&p.Estado=="Preparado"){<span class="badge bg-warning text-dark align-self-center">Pendiente de reparto</span>}</div></td></tr>}</tbody></table></div></div>
@code{
 [SupplyParameterFromQuery(Name="clienteId")]public int?ClienteIdInicial{get;set;}
 private PedidoCrearDto nuevo=NuevoPedido();private PedidoEntregarDto entrega=new();private PedidoDto?pedidoAEntregar;private List<PedidoDto>pedidos=[];private List<ClienteDto>clientes=[];private List<DireccionClienteDto>direcciones=[];private List<TuboDto>disponibles=[];private string buscarCilindro="";private string?mensaje;private bool esError;private bool inicializarFirma;
 private static PedidoCrearDto NuevoPedido()=>new(){FechaPrevistaEntrega=DateOnly.FromDateTime(DateTime.Today)};
 private List<TuboDto>DisponiblesParaCliente=>nuevo.ClienteId==0?[]:disponibles.Where(x=>x.TipoPropietario!=2||x.ClientePropietarioId==nuevo.ClienteId).ToList();
 private List<TuboDto>CilindrosFiltrados=>DisponiblesParaCliente.Where(x=>nuevo.CilindroIds.Contains(x.Id)||CoincideBusqueda(x)).OrderByDescending(x=>nuevo.CilindroIds.Contains(x.Id)).ThenBy(x=>x.CodigoInterno).ToList();
 private bool CoincideBusqueda(TuboDto x)=>string.IsNullOrWhiteSpace(buscarCilindro)||string.Join(' ',x.CodigoInterno,x.NumeroSerie,x.IdentificacionGrabada,x.Gas,x.Capacidad,x.Propietario).Contains(buscarCilindro.Trim(),StringComparison.OrdinalIgnoreCase);
 private int ClienteSeleccionado{get=>nuevo.ClienteId;set{nuevo.ClienteId=value;buscarCilindro="";nuevo.CilindroIds.RemoveAll(id=>!disponibles.Any(x=>x.Id==id&&(x.TipoPropietario!=2||x.ClientePropietarioId==value)));}}
 private async Task CambiarCliente(int?id){ClienteSeleccionado=id??0;await CargarDirecciones();}
 private string ModalidadEntrega{get=>nuevo.ModalidadEntrega;set{nuevo.ModalidadEntrega=value;if(value!="Domicilio")nuevo.DireccionEntregaId=null;}}
 protected override async Task OnInitializedAsync(){clientes=(await ClientesApi.ObtenerTodosAsync()).ToList();await Cargar();if(ClienteIdInicial.HasValue&&clientes.Any(x=>x.Id==ClienteIdInicial)){ClienteSeleccionado=ClienteIdInicial.Value;await CargarDirecciones();}}
 private async Task Cargar(){pedidos=await Api.Obtener();disponibles=(await CilindrosApi.Todos()).Where(x=>x.EstadoDisponibilidad==1).ToList();}
 private async Task CargarDirecciones(){direcciones=nuevo.ClienteId>0?(await ClientesApi.ObtenerDireccionesAsync(nuevo.ClienteId)).ToList():[];nuevo.DireccionEntregaId=direcciones.FirstOrDefault(x=>x.EsPrincipalEntrega)?.Id??direcciones.FirstOrDefault()?.Id;}
 private static string Direccion(DireccionClienteDto d)=>$"{d.Calle} {d.Numero}, {d.Localidad}, {d.Provincia}".Replace("  "," ");
 private void Seleccionar(int id,bool marcado){if(marcado&&!nuevo.CilindroIds.Contains(id))nuevo.CilindroIds.Add(id);else if(!marcado)nuevo.CilindroIds.Remove(id);}
 private async Task Crear(){await Ejecutar(async()=>{await Api.Crear(nuevo);nuevo=NuevoPedido();buscarCilindro="";direcciones=[];mensaje="Pedido creado y cilindros reservados.";});}
 private static bool EsDevolucionPropia(PedidoDto p)=>p.Cilindros.Count>0&&p.Cilindros.All(x=>x.TipoPropietario==2&&x.ClientePropietarioId==p.ClienteId);
 protected override async Task OnAfterRenderAsync(bool firstRender){if(inicializarFirma&&pedidoAEntregar is not null){inicializarFirma=false;await JS.InvokeVoidAsync("firmaRemito.inicializar","firma-entrega");}}
 private Task Emitir(long id)=>Ejecutar(async()=>{await Api.EmitirRemito(id);mensaje="Remito emitido correctamente.";});private async Task PrepararEntrega(PedidoDto p){pedidoAEntregar=p;entrega=EsDevolucionPropia(p)?new(){Modalidad="Devolución de cilindro propio",DiasSinCargo=0}:new();mensaje=null;inicializarFirma=true;await JS.InvokeVoidAsync("window.scrollTo",0,0);}private void CancelarEntrega(){pedidoAEntregar=null;entrega=new();}private Task LimpiarFirma()=>JS.InvokeVoidAsync("firmaRemito.limpiar","firma-entrega").AsTask();
 private async Task ConfirmarEntrega(){if(pedidoAEntregar is null)return;entrega.FirmaDataUrl=await JS.InvokeAsync<string>("firmaRemito.obtener","firma-entrega");if(string.IsNullOrWhiteSpace(entrega.FirmaDataUrl)){esError=true;mensaje="La persona que recibe debe firmar el remito.";return;}await Ejecutar(async()=>{await Api.ConfirmarEntrega(pedidoAEntregar.Id,entrega);pedidoAEntregar=null;entrega=new();mensaje="Entrega confirmada y remito firmado electrónicamente.";});}
 private async Task Ejecutar(Func<Task>f){try{esError=false;mensaje=null;await f();await Cargar();}catch(Exception e){esError=true;mensaje=e.Message;}}
}
<style>.signature-canvas{display:block;height:260px;border:2px solid #0d6efd;border-radius:.75rem;background:#fff;touch-action:none;cursor:crosshair}</style>
