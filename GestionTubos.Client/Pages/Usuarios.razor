@page "/usuarios"
@attribute [Authorize(Roles = "Superadministrador,Administrador")]
@inject AutenticacionApiService Api

<PageTitle>Usuarios</PageTitle>
<h1>Usuarios</h1>
<div class="card shadow-sm mb-4"><div class="card-body"><h5>Nuevo usuario</h5>
<EditForm Model="nuevo" OnValidSubmit="Crear"><DataAnnotationsValidator />
<div class="row g-3"><div class="col-md-3"><label class="form-label">Nombre completo</label><InputText class="form-control" @bind-Value="nuevo.NombreCompleto" /></div>
<div class="col-md-3"><label class="form-label">Correo</label><InputText class="form-control" @bind-Value="nuevo.Correo" /></div>
<div class="col-md-2"><label class="form-label">Contraseña</label><InputText type="password" class="form-control" @bind-Value="nuevo.Contrasena" /></div>
<div class="col-md-2"><label class="form-label">Rol</label><InputSelect class="form-select" @bind-Value="nuevo.Rol"><option>Empleado</option><option>Administrador</option><AuthorizeView Roles="Superadministrador" Context="rolContext"><option>Superadministrador</option></AuthorizeView></InputSelect></div>
<div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Crear</button></div></div><ValidationSummary />
@if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3 mb-0">@mensaje</div> }
</EditForm></div></div>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th></tr></thead><tbody>@foreach (var u in usuarios) { <tr><td>@u.NombreCompleto</td><td>@u.Correo</td><td>@string.Join(", ", u.Roles)</td><td>@(u.Activo ? "Activo" : "Inactivo")</td></tr> }</tbody></table></div>

@code { private List<UsuarioDto> usuarios=[]; private UsuarioCrearDto nuevo=new(); private string? mensaje; private bool esError;
protected override async Task OnInitializedAsync()=>usuarios=(await Api.UsuariosAsync()).ToList();
private async Task Crear(){try{await Api.CrearUsuarioAsync(nuevo);nuevo=new();usuarios=(await Api.UsuariosAsync()).ToList();mensaje="Usuario creado correctamente.";esError=false;}catch(Exception ex){mensaje=ex.Message;esError=true;}}
}
