@page "/cilindros/nuevo"
@page "/cilindros/{Id:int}"
@attribute [Authorize(Roles = "Superadministrador,Administrador")]
@inject TuboApiService Api
@inject CatalogoApiService Catalogos
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Editar tubo" : "Cargar tubo")</PageTitle>
<div class="mb-4">
    <a href="cilindros" class="text-decoration-none">← Volver al stock</a>
    <h1 class="mt-3 mb-1">@(Id.HasValue ? $"Editar tubo #{Id}" : "Cargar nuevo tubo")</h1>
    <p class="text-muted mb-0">El ID interno se asigna automáticamente. Ingresá el código de serie que está grabado en el tubo.</p>
</div>

@if (error is not null) { <div class="alert alert-danger">@error</div> }

<EditForm Model="modelo" OnValidSubmit="Guardar" class="card stock-form">
    <DataAnnotationsValidator />
    <div class="card-body p-lg-4">
        <ValidationSummary />
        <h2 class="h5 mb-3">Identificación</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Código de serie <span class="text-danger">*</span></label>
                <InputText class="form-control form-control-lg" @bind-Value="modelo.CodigoInterno" placeholder="Código grabado en el tubo" autocomplete="off" />
                <ValidationMessage For="@(() => modelo.CodigoInterno)" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo de gas <span class="text-danger">*</span></label>
                <InputSelect class="form-select form-select-lg" @bind-Value="modelo.TipoGasId"><option value="0">Seleccionar</option>@foreach (var x in gases) { <option value="@x.Id">@x.Nombre</option> }</InputSelect>
                <ValidationMessage For="@(() => modelo.TipoGasId)" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Capacidad <span class="text-danger">*</span></label>
                <InputSelect class="form-select form-select-lg" @bind-Value="modelo.CapacidadTuboId"><option value="0">Seleccionar</option>@foreach (var x in capacidades) { <option value="@x.Id">@x.Valor @x.Unidad</option> }</InputSelect>
                <ValidationMessage For="@(() => modelo.CapacidadTuboId)" />
            </div>
        </div>

        <h2 class="h5 mb-3">Datos de stock</h2>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Marca</label><InputText class="form-control" @bind-Value="modelo.Marca" placeholder="Opcional" /></div>
            <div class="col-md-4">
                <label class="form-label">Propietario</label>
                <InputSelect class="form-select" @bind-Value="modelo.TipoPropietario"><option value="1">Oxígeno Norte</option><option value="4">Otro propietario</option></InputSelect>
            </div>
            @if (modelo.TipoPropietario == 4)
            {
                <div class="col-md-4"><label class="form-label">Nombre del propietario <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="modelo.NombrePropietarioExterno" /></div>
            }
            <div class="col-md-4">
                <label class="form-label">Ubicación <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="modelo.UbicacionId"><option value="0">Seleccionar</option>@foreach (var x in ubicaciones) { <option value="@x.Id">@x.Nombre</option> }</InputSelect>
                <ValidationMessage For="@(() => modelo.UbicacionId)" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <InputSelect class="form-select" @bind-Value="modelo.EstadoDisponibilidad"><option value="1">Disponible</option><option value="4">En uso</option><option value="7">Mantenimiento</option><option value="10">Extraviado</option></InputSelect>
            </div>
            <div class="col-12"><hr class="my-2" /></div>
            <div class="col-12"><h2 class="h5 mb-0">Prueba hidráulica</h2><p class="text-muted small mb-0">Ingresá los datos grabados o documentados de la última prueba realizada.</p></div>
            <div class="col-md-4">
                <label class="form-label">Fecha de la prueba <span class="text-danger">*</span></label>
                <InputDate class="form-control" @bind-Value="modelo.FechaPruebaHidraulica" />
                <ValidationMessage For="@(() => modelo.FechaPruebaHidraulica)" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha de vencimiento <span class="text-danger">*</span></label>
                <InputDate class="form-control" @bind-Value="modelo.FechaVencimientoPrueba" />
                <ValidationMessage For="@(() => modelo.FechaVencimientoPrueba)" />
            </div>
            <div class="col-12"><label class="form-label">Observaciones</label><InputTextArea class="form-control" rows="3" @bind-Value="modelo.Observaciones" placeholder="Información adicional del tubo" /></div>
        </div>
    </div>
    <div class="card-footer bg-white border-top p-3 p-lg-4 d-flex flex-wrap gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
        <button class="btn btn-primary px-4" disabled="@guardando">@(guardando ? "Guardando..." : Id.HasValue ? "Guardar cambios" : "Cargar tubo")</button>
    </div>
</EditForm>

@code {
    [Parameter] public int? Id { get; set; }
    private TuboGuardarDto modelo = NuevoModelo();
    private List<TipoGasDto> gases = [];
    private List<CapacidadDto> capacidades = [];
    private List<UbicacionDto> ubicaciones = [];
    private string? error;
    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            gases = await Catalogos.GasesAsync();
            capacidades = await Catalogos.CapacidadesAsync();
            ubicaciones = (await Catalogos.UbicacionesAsync()).Where(x => x.EsInterna).ToList();
            if (Id.HasValue)
            {
                var x = await Api.Uno(Id.Value);
                if (x is null) { error = "No se encontró el tubo."; return; }
                modelo = new TuboGuardarDto { CodigoInterno = x.CodigoInterno, TipoGasId = x.TipoGasId, CapacidadTuboId = x.CapacidadTuboId, TipoPropietario = x.TipoPropietario is 1 ? 1 : 4, NombrePropietarioExterno = x.TipoPropietario is 1 ? null : x.Propietario, EstadoFisico = 1, EstadoContenido = 4, EstadoDisponibilidad = x.EstadoDisponibilidad, UbicacionId = x.UbicacionId, Marca = x.Marca, Observaciones = x.Observaciones, RegistrarPruebaInicial = true, PruebaAprobada = true, EntidadPrueba = "No especificada", FechaPruebaHidraulica = x.FechaPruebaHidraulica ?? DateOnly.FromDateTime(GestionTubos.Shared.HoraArgentina.Hoy), FechaVencimientoPrueba = x.FechaVencimientoPrueba ?? DateOnly.FromDateTime(GestionTubos.Shared.HoraArgentina.Hoy.AddYears(5)) };
            }
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private static TuboGuardarDto NuevoModelo() => new() { TipoPropietario = 1, EstadoFisico = 1, EstadoContenido = 4, EstadoDisponibilidad = 1, RegistrarPruebaInicial = true, PruebaAprobada = true, EntidadPrueba = "No especificada" };
    private void Cancelar() => Nav.NavigateTo("/cilindros");
    private async Task Guardar()
    {
        if (guardando) return;
        guardando = true; error = null;
        try { if (Id.HasValue) await Api.Editar(Id.Value, modelo); else await Api.Crear(modelo); Nav.NavigateTo("/cilindros"); }
        catch (Exception ex) { error = ex.Message; }
        finally { guardando = false; }
    }
}
