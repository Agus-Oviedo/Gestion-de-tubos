@page "/cilindros/nuevo"
@page "/cilindros/{Id:int}"
@attribute [Authorize(Roles = "Superadministrador,Administrador")]
@inject GestionTubos.Client.Services.TuboApiService Api
@inject GestionTubos.Client.Services.CatalogoApiService Catalogos
@inject GestionTubos.Client.Services.ClienteApiService Clientes
@inject NavigationManager Nav
<PageTitle>Registro de cilindro</PageTitle><h1>@(Id.HasValue?"Editar cilindro":"Nuevo cilindro")</h1><p class="text-muted">Cada cilindro se identifica y rastrea por separado.</p>
@if(error is not null){<div class="alert alert-danger">@error</div>}
<EditForm Model="m" OnValidSubmit="Guardar" class="card card-body"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3">
<div class="col-md-4"><label class="form-label">Código interno</label><InputText class="form-control" @bind-Value="m.CodigoInterno"/></div><div class="col-md-4"><label class="form-label">Número de serie</label><InputText class="form-control" @bind-Value="m.NumeroSerie"/></div><div class="col-md-4"><label class="form-label">Identificación grabada</label><InputText class="form-control" @bind-Value="m.IdentificacionGrabada"/></div>
<div class="col-md-4"><label class="form-label">Gas</label><InputSelect class="form-select" @bind-Value="m.TipoGasId"><option value="0">Seleccionar</option>@foreach(var x in gases){<option value="@x.Id">@x.Nombre</option>}</InputSelect></div><div class="col-md-4"><label class="form-label">Capacidad</label><InputSelect class="form-select" @bind-Value="m.CapacidadTuboId"><option value="0">Seleccionar</option>@foreach(var x in capacidades){<option value="@x.Id">@x.Valor @x.Unidad</option>}</InputSelect></div>@if(m.TipoPropietario==2){<div class="col-md-4"><label class="form-label">Ubicación</label><div class="form-control bg-light text-muted">En poder del cliente</div><div class="form-text">La ubicación interna se indicará cuando el cilindro ingrese a planta.</div></div>}else{<div class="col-md-4"><label class="form-label">Ubicación</label><InputSelect class="form-select" @bind-Value="m.UbicacionId"><option value="0">Seleccionar</option>@foreach(var x in ubicaciones){<option value="@x.Id">@x.Nombre</option>}</InputSelect></div>}
<div class="col-md-4"><label class="form-label">Propietario</label><InputSelect class="form-select" @bind-Value="m.TipoPropietario"><option value="1">Oxígeno Norte</option><option value="2">Cliente</option><option value="3">Proveedor</option><option value="4">Otro tercero</option></InputSelect></div>@if(m.TipoPropietario==2){<div class="col-md-4"><label class="form-label">Cliente propietario</label><ClienteBuscador Clientes="clientes" ClienteId="m.ClientePropietarioId" ClienteIdChanged="id=>m.ClientePropietarioId=id"/></div>}else if(m.TipoPropietario is 3 or 4){<div class="col-md-4"><label class="form-label">Nombre del propietario</label><InputText class="form-control" @bind-Value="m.NombrePropietarioExterno"/></div>}
<div class="col-md-4"><label class="form-label">Contenido</label><InputSelect class="form-select" @bind-Value="m.EstadoContenido"><option value="1">Lleno</option><option value="2">Vacío</option><option value="3">Parcial</option><option value="4">Desconocido</option></InputSelect></div><div class="col-md-4"><label class="form-label">Estado físico</label><InputSelect class="form-select" @bind-Value="m.EstadoFisico"><option value="1">Bueno</option><option value="2">Con observaciones</option><option value="3">Dañado</option><option value="4">Inutilizable</option></InputSelect></div>@if(m.TipoPropietario==2){<div class="col-md-4"><label class="form-label">Estado operativo</label><div class="form-control bg-light text-muted">Administrado por recepciones, cargas y entregas</div><div class="form-text">El cilindro pertenece exclusivamente al cliente y nunca integra el stock disponible general.</div></div>}else{<div class="col-md-4"><label class="form-label">Disponibilidad</label><InputSelect class="form-select" @bind-Value="m.EstadoDisponibilidad"><option value="1">Disponible</option><option value="5">En carga</option><option value="6">Pendiente de inspección</option><option value="7">Mantenimiento</option><option value="8">Prueba hidráulica</option><option value="10">Extraviado</option></InputSelect></div>}
<div class="col-md-4"><label class="form-label">Marca</label><InputText class="form-control" @bind-Value="m.Marca"/></div><div class="col-md-4"><label class="form-label">Fabricante</label><InputText class="form-control" @bind-Value="m.Fabricante"/></div><div class="col-12"><label class="form-label">Observaciones</label><InputTextArea class="form-control" @bind-Value="m.Observaciones"/></div></div>
@if(!Id.HasValue){<hr class="my-4"/><div class="form-check form-switch mb-3"><InputCheckbox class="form-check-input" @bind-Value="m.RegistrarPruebaInicial"/><label class="form-check-label fw-bold">Registrar la última prueba hidráulica</label></div>
@if(m.RegistrarPruebaInicial){<div class="rounded border bg-light p-3"><div class="row g-3"><div class="col-md-3"><label class="form-label">Fecha de prueba</label><InputDate class="form-control" @bind-Value="m.FechaPruebaHidraulica"/></div><div class="col-md-3"><label class="form-label">Vencimiento</label><InputDate class="form-control" @bind-Value="m.FechaVencimientoPrueba"/></div><div class="col-md-3"><label class="form-label">Entidad realizadora</label><InputText class="form-control" @bind-Value="m.EntidadPrueba"/></div><div class="col-md-3"><label class="form-label">Certificado</label><InputText class="form-control" @bind-Value="m.NumeroCertificadoPrueba"/></div><div class="col-md-3"><label class="form-label">Resultado</label><InputSelect class="form-select" @bind-Value="m.PruebaAprobada"><option value="true">Aprobada</option><option value="false">Rechazada</option></InputSelect></div><div class="col-md-9"><label class="form-label">Observaciones de la prueba</label><InputText class="form-control" @bind-Value="m.ObservacionesPrueba"/></div></div></div>}else{<div class="alert alert-warning">Sin una prueba vigente, el cilindro se guardará en estado <strong>Prueba hidráulica</strong> y no podrá entregarse.</div>}}
<div class="mt-4"><button class="btn btn-primary me-2">Guardar</button><button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button></div></EditForm>
@code{[Parameter]public int?Id{get;set;}[SupplyParameterFromQuery(Name="clienteId")]public int?ClienteId{get;set;}[SupplyParameterFromQuery(Name="volver")]public string?VolverA{get;set;}private TuboGuardarDto m=new();private List<TipoGasDto>gases=[];private List<CapacidadDto>capacidades=[];private List<UbicacionDto>ubicaciones=[];private List<ClienteDto>clientes=[];private string?error;protected override async Task OnInitializedAsync(){gases=await Catalogos.GasesAsync();capacidades=await Catalogos.CapacidadesAsync();ubicaciones=await Catalogos.UbicacionesAsync();clientes=(await Clientes.ObtenerTodosAsync()).ToList();if(Id.HasValue){var x=await Api.Uno(Id.Value);if(x is not null)m=new(){CodigoInterno=x.CodigoInterno,NumeroSerie=x.NumeroSerie,IdentificacionGrabada=x.IdentificacionGrabada,TipoGasId=x.TipoGasId,CapacidadTuboId=x.CapacidadTuboId,TipoPropietario=x.TipoPropietario,ClientePropietarioId=x.ClientePropietarioId,NombrePropietarioExterno=x.NombrePropietarioExterno,EstadoFisico=x.EstadoFisico,EstadoContenido=x.EstadoContenido,EstadoDisponibilidad=x.EstadoDisponibilidad,UbicacionId=x.UbicacionId,Marca=x.Marca,Fabricante=x.Fabricante,FechaFabricacion=x.FechaFabricacion,Observaciones=x.Observaciones};}else if(ClienteId.HasValue&&clientes.Any(x=>x.Id==ClienteId.Value)){m.TipoPropietario=2;m.ClientePropietarioId=ClienteId;}}private void Cancelar()=>Nav.NavigateTo(VolverA=="recepciones"?(ClienteId.HasValue?$"/recepciones?clienteId={ClienteId}":"/recepciones"):(ClienteId.HasValue?$"/clientes/{ClienteId}/cilindros":"/cilindros"));private async Task Guardar(){try{if(Id.HasValue){await Api.Editar(Id.Value,m);Nav.NavigateTo(ClienteId.HasValue?$"/clientes/{ClienteId}/cilindros":"/cilindros");}else{var creado=await Api.Crear(m);Nav.NavigateTo(VolverA=="recepciones"?$"/recepciones?clienteId={creado.ClientePropietarioId}&cilindroId={creado.Id}":(ClienteId.HasValue?$"/clientes/{ClienteId}/cilindros":"/cilindros"));}}catch(Exception e){error=e.Message;}}}
