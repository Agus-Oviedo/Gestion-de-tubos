@page "/remitos/{PedidoId:long}/firma"
@attribute [Authorize]
@inject PedidoApiService Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Confirmar recepción</PageTitle>
@if(cargando){<p>Cargando remito...</p>}
else if(pedido is null){<div class="alert alert-warning">No se encontró el remito.</div>}
else if(pedido.Estado=="Entregado"){<div class="alert alert-success">Este remito ya fue confirmado.</div><a class="btn btn-primary" href="@($"remitos/{PedidoId}")">Ver comprobante</a>}
else{
 <div class="customer-signature-page mx-auto">
  <div class="mb-3"><button type="button" class="btn btn-outline-secondary" @onclick="Salir">← Volver a Entregas</button></div>
  <div class="text-center mb-4"><img src="oxigeno-norte-logo.png" alt="Oxígeno Norte" style="max-width:150px"/><h1 class="h2 mt-3">Confirmación de recepción</h1><p class="text-muted">Revisá los tubos recibidos y completá tus datos.</p></div>
  @if(!string.IsNullOrWhiteSpace(mensaje)){<div class="alert alert-danger">@mensaje</div>}
  <div class="card shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between"><strong>Remito @pedido.NumeroRemito</strong><span>@pedido.FechaHoraUtc.EnArgentina().ToString("dd/MM/yyyy")</span></div><h2 class="h4 mt-3">@pedido.Cliente</h2><hr/>@foreach(var tubo in pedido.Cilindros){<div class="py-2 border-bottom"><strong>@tubo.Codigo</strong> · @tubo.Gas · @tubo.Capacidad</div>}</div></div>
  <EditForm Model="entrega" OnValidSubmit="Confirmar"><DataAnnotationsValidator/><ValidationSummary/><div class="card shadow-sm"><div class="card-body"><div class="row g-3"><div class="col-md-7"><label class="form-label">Aclaración / nombre completo</label><InputText class="form-control form-control-lg" @bind-Value="entrega.PersonaRecibe"/></div><div class="col-md-5"><label class="form-label">DNI</label><InputText class="form-control form-control-lg" inputmode="numeric" @bind-Value="entrega.DniRecibe"/></div><div class="col-12"><div class="d-flex justify-content-between align-items-center"><label class="form-label fw-bold">Firma</label><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Limpiar">Limpiar</button></div><canvas id="firma-cliente" class="signature-canvas w-100"></canvas></div></div><button class="btn btn-success btn-lg w-100 mt-4">Confirmar recepción</button></div></div></EditForm>
 </div>
}

@code{
 [Parameter]public long PedidoId{get;set;} private PedidoDto?pedido;private PedidoEntregarDto entrega=new(){Modalidad="Entrega",DiasSinCargo=0};private bool cargando=true;private string?mensaje;private bool iniciarFirma;
 protected override async Task OnParametersSetAsync(){cargando=true;pedido=(await Api.Obtener()).FirstOrDefault(x=>x.Id==PedidoId);cargando=false;iniciarFirma=pedido is not null&&pedido.Estado!="Entregado";}
 protected override async Task OnAfterRenderAsync(bool firstRender){if(iniciarFirma){iniciarFirma=false;await JS.InvokeVoidAsync("firmaRemito.inicializar","firma-cliente");}}
 private Task Limpiar()=>JS.InvokeVoidAsync("firmaRemito.limpiar","firma-cliente").AsTask();
 private void Salir()=>Navigation.NavigateTo("pedidos");
 private async Task Confirmar(){try{mensaje=null;entrega.FirmaDataUrl=await JS.InvokeAsync<string>("firmaRemito.obtener","firma-cliente");if(string.IsNullOrWhiteSpace(entrega.FirmaDataUrl)){mensaje="Firmá dentro del recuadro para confirmar la recepción.";return;}await Api.ConfirmarEntrega(PedidoId,entrega);Navigation.NavigateTo($"remitos/{PedidoId}");}catch(Exception ex){mensaje=ex.Message;}}
}
<style>.customer-signature-page{max-width:850px}.signature-canvas{display:block;height:300px;border:3px solid #198754;border-radius:.75rem;background:#fff;touch-action:none;cursor:crosshair}</style>
