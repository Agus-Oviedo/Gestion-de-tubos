@page "/cargas"
@attribute [Authorize]
@inject TuboApiService CilindrosApi
@inject OperacionApiService Api
<PageTitle>Carga de cilindros</PageTitle><h1>Carga de cilindros</h1><p class="text-muted">Los cilindros recibidos para carga aparecen directamente en esta lista. Solo tenés que finalizarlos cuando estén llenos.</p>
@if(!string.IsNullOrWhiteSpace(mensaje)){<div class="alert @(error?"alert-danger":"alert-success")">@mensaje</div>}
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card card-body h-100"><h2 class="h4">Ingreso manual opcional</h2><p class="text-muted small">Usalo solamente para un cilindro que ya estaba en planta. Los recibidos desde Recepciones no necesitan este paso.</p><EditForm Model="inicio" OnValidSubmit="Iniciar"><DataAnnotationsValidator/><ValidationSummary/><label class="form-label">Cilindro vacío o parcial disponible</label><InputSelect class="form-select mb-3" @bind-Value="inicio.CilindroId"><option value="0">Seleccionar</option>@foreach(var c in candidatos){<option value="@c.Id">@c.CodigoInterno · @c.Gas · @c.Capacidad · @Contenido(c.EstadoContenido)</option>}</InputSelect><label class="form-label">Observaciones</label><InputTextArea class="form-control mb-3" @bind-Value="inicio.Observaciones"/><button class="btn btn-outline-primary">Agregar manualmente</button></EditForm></div></div>
<div class="col-lg-6"><div class="card card-body h-100"><h2 class="h4">Resumen</h2><div class="row text-center"><div class="col"><span class="text-muted d-block">Disponibles para ingreso manual</span><strong class="fs-2">@candidatos.Count</strong></div><div class="col"><span class="text-muted d-block">En la fila de carga</span><strong class="fs-2 text-primary">@enCarga.Count</strong></div></div><hr/><p class="mb-0 text-muted">Finalizar una carga cambia automáticamente el contenido a <strong>Lleno</strong> y devuelve el cilindro a <strong>Disponible</strong>.</p></div></div></div>
<h2 class="h4">Cilindros actualmente en carga</h2>@if(enCarga.Count==0){<div class="alert alert-info">No hay cilindros en proceso de carga.</div>}else{<div class="row g-3">@foreach(var c in enCarga){<div class="col-lg-6"><div class="card card-body"><div class="d-flex justify-content-between"><div><h3 class="h5 mb-1">@c.CodigoInterno · @c.Gas</h3><span class="text-muted">@c.Capacidad · @Contenido(c.EstadoContenido) · @c.Propietario</span></div><span class="badge bg-primary align-self-start">En carga</span></div><div class="mt-3 d-flex flex-wrap gap-2"><button class="btn btn-success" @onclick="()=>Finalizar(c.Id)">Finalizar como lleno</button><button class="btn btn-outline-secondary" @onclick="()=>PrepararCancelacion(c.Id)">Cancelar/derivar</button></div>@if(cancelacion?.CilindroId==c.Id){<EditForm Model="cancelacion" OnValidSubmit="Cancelar" class="mt-3 border-top pt-3"><DataAnnotationsValidator/><ValidationSummary/><label class="form-label">Destino</label><InputSelect class="form-select mb-2" @bind-Value="cancelacion.Destino"><option value="Disponible">Disponible, sin completar carga</option><option value="Inspeccion">Pendiente de inspección</option><option value="Mantenimiento">En mantenimiento</option></InputSelect><label class="form-label">Motivo obligatorio</label><InputText class="form-control mb-2" @bind-Value="cancelacion.Motivo"/><button class="btn btn-danger btn-sm me-2">Confirmar cancelación</button><button type="button" class="btn btn-outline-secondary btn-sm" @onclick="()=>cancelacion=null">Volver</button></EditForm>}</div></div>}</div>}
@code{private CargaIniciarDto inicio=new();private CargaCancelarDto?cancelacion;private List<TuboDto>todos=[];private string?mensaje;private bool error;private List<TuboDto>candidatos=>todos.Where(x=>x.EstadoDisponibilidad==1&&x.EstadoContenido is 2 or 3).ToList();private List<TuboDto>enCarga=>todos.Where(x=>x.EstadoDisponibilidad==5).ToList();protected override Task OnInitializedAsync()=>Cargar();private async Task Cargar()=>todos=await CilindrosApi.Todos();private Task Iniciar()=>Ejecutar(async()=>{await Api.IniciarCarga(inicio);inicio=new();mensaje="Cilindro ingresado a carga.";});private Task Finalizar(int id)=>Ejecutar(async()=>{await Api.FinalizarCarga(new(){CilindroId=id});mensaje="Carga finalizada: cilindro lleno y disponible.";});private void PrepararCancelacion(int id)=>cancelacion=new(){CilindroId=id};private async Task Cancelar(){if(cancelacion is null)return;await Ejecutar(async()=>{await Api.CancelarCarga(cancelacion);cancelacion=null;mensaje="Carga cancelada y estado actualizado.";});}private async Task Ejecutar(Func<Task>f){try{error=false;mensaje=null;await f();await Cargar();}catch(Exception e){error=true;mensaje=e.Message;}}private static string Contenido(int e)=>e switch{1=>"Lleno",2=>"Vacío",3=>"Parcial",_=>"Desconocido"};}
