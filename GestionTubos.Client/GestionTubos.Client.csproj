<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Chrome 109 (último para Windows 7) necesita el manejo de excepciones
         mediante JavaScript. Evitar también SIMD para equipos antiguos.
         Publicar requiere wasm-tools-net8 al usar el SDK de .NET 9. -->
    <WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
    <WasmEnableSIMD>false</WasmEnableSIMD>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionTubos.Shared\GestionTubos.Shared.csproj" />
  </ItemGroup>

</Project>
